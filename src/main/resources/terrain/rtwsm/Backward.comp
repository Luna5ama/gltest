#version 460 core

#ifdef GPU_VENDOR_NVIDIA
#extension GL_NV_shader_subgroup_partitioned : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#else
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_clustered : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#endif

#include "../GBuffers.glsl"
#include "../GenericGBuffer.glsl"
#include "../GlobalCamera.glsl"
#include "ShadowParams.glsl"
#include "ShadowSamplers.glsl"

#define GROUP_SIZE 16

layout(local_size_x = GROUP_SIZE, local_size_y = GROUP_SIZE) in;

layout(r32ui) uniform coherent volatile uimage2D uimg_imap2D;
layout(rgba32ui) uniform readonly uimage2D uimg_gData1;

uniform float uvImportanceMul;

void importance(ivec2 gCoord, out uint p, out float v) {
//    if (any(greaterThanEqual(gCoord, textureSize(usam_gData1, 0)))) {
    if (any(greaterThanEqual(gCoord, imageSize(uimg_gData1)))) {
        p = 0xFFFFFFFFu;
        v = 0u;
        return;
    }

    float gDepth = texelFetch(usam_gDepth, gCoord, 0).x;
    if (gDepth == 1.0) {
        p = 0xFFFFFFFFu;
        v = 0u;
        return;
    }

    GBufferData gs_data;
//    uvec4 packedData = texelFetch(usam_gData1, gCoord, 0);
    uvec4 packedData = imageLoad(uimg_gData1, gCoord);
    gbuffer_unpack1(packedData, gs_data);
    vec3 worldCoord = gs_data.worldCoord;
    vec3 worldNormal = gs_data.worldNormal;
//    vec3 worldCoord = gbuffer_readCoordI(usam_gData1, gCoord);
//    vec3 worldNormal = gbuffer_readNormalI(usam_gData1, gCoord);

    vec3 viewDir = normalize(worldCoord);

    worldCoord += uShadowMap.shadowWorldOffset.xyz;
    vec4 shadowCS = uShadowMap.matrix * vec4(worldCoord, 1.0);
    shadowCS /= shadowCS.w;

    float importance = 1.0;
    float pDist = max(length(worldCoord), 1.0);

    // Distance function
    importance *= 1.0 / pDist;

    // Surface normal function
    const float SN_BETA = 2.0;
    importance *= 1.0 + SN_BETA * max(dot(worldNormal, -viewDir), 0.0);

    const float LSN_BETA = 1.0;
    importance *= 1.0 + LSN_BETA * sqrt(pDist) * pow(1.0 - abs(dot(worldNormal, uShadowMap.lightDir)), 8.0);

    // Shadow Edge function
    vec2 shadowTS = shadowCS.xy * 0.5 + 0.5;
    vec2 shadowTSWarped = rtwsm_warpTexCoord(usam_warpingMap, shadowTS);

    float center = texture(usam_shadowDepth, shadowTSWarped).x;
    float maxDiff = 0.0;
    maxDiff = max(maxDiff, abs(center - textureOffset(usam_shadowDepth, shadowTSWarped, ivec2(-1, -1)).x));
    maxDiff = max(maxDiff, abs(center - textureOffset(usam_shadowDepth, shadowTSWarped, ivec2(-1, 0)).x));
    maxDiff = max(maxDiff, abs(center - textureOffset(usam_shadowDepth, shadowTSWarped, ivec2(-1, 1)).x));
    maxDiff = max(maxDiff, abs(center - textureOffset(usam_shadowDepth, shadowTSWarped, ivec2(0, -1)).x));
    maxDiff = max(maxDiff, abs(center - textureOffset(usam_shadowDepth, shadowTSWarped, ivec2(0, 1)).x));
    maxDiff = max(maxDiff, abs(center - textureOffset(usam_shadowDepth, shadowTSWarped, ivec2(1, -1)).x));
    maxDiff = max(maxDiff, abs(center - textureOffset(usam_shadowDepth, shadowTSWarped, ivec2(1, 0)).x));
    maxDiff = max(maxDiff, abs(center - textureOffset(usam_shadowDepth, shadowTSWarped, ivec2(1, 1)).x));
    maxDiff *= ubo_cameraDefault.planeZ.y - ubo_cameraDefault.planeZ.x;

    const float NON_EDGE = 0.01;
    importance *= mix(NON_EDGE, 1.0, smoothstep(0.5, 2.0, maxDiff));

    if (shadowCS.x < -1.0 || shadowCS.x > 1.0 || shadowCS.y < -1.0 || shadowCS.y > 1.0 || shadowCS.z < -1.0 || shadowCS.z > 1.0) {
        p = 0xFFFFFFFFu;
        v = 0u;
        return;
    }

    uvec2 shadowPos = uvec2(shadowTS.xy * imageSize(uimg_imap2D) + 0.5);

    p = shadowPos.y << 16 | shadowPos.x;
    v = importance;

    return;
}

void writeOutput(uint p, float v) {
    if (p == 0xFFFFFFFFu) return;
    imageAtomicMax(uimg_imap2D, ivec2(p & 0xFFFFu, p >> 16), uint(v * uvImportanceMul));
}

void main() {
    uint p;
    float v;
    importance(ivec2(gl_GlobalInvocationID.xy), p, v);

    #ifdef GPU_VENDOR_NVIDIA
    uvec4 pballot = subgroupPartitionNV(p);
    if (subgroupBallotFindLSB(pballot) == gl_SubgroupInvocationID) {
        writeOutput(p, subgroupPartitionedMaxNV(v, pballot));
    }
    #else
    if (p == 0xFFFFFFFFu) {
        p = subgroupMin(p);
    }
    if (subgroupAllEqual(p)) {
        if (gl_SubgroupInvocationID == 0) {
            writeOutput(p, subgroupMax(v));
        }
        return;
    }

    #define CLUSTERED_DEDUP(n) if (subgroupClusteredXor(p, n) != 0) { writeOutput(p, v); return; } if ((gl_SubgroupInvocationID & (n - 1u)) != 0u) return; v = subgroupClusteredMax(v, n);

    CLUSTERED_DEDUP(2u)
    CLUSTERED_DEDUP(4u)
    CLUSTERED_DEDUP(8u)
    CLUSTERED_DEDUP(16u)
    writeOutput(p, v);

    #endif
}
