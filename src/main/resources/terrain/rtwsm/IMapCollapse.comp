#version 460 core
#pragma optionNV (unroll all)

#extension GL_KHR_shader_subgroup_arithmetic : enable

layout(local_size_x = GROUP_SIZE_X, local_size_y = GROUP_SIZE_Y) in;

layout(r32f) uniform restrict writeonly image1DArray uimg_imap1D;
uniform sampler2D usam_imap2D;

shared float collapseBuffer[GROUP_SIZE_Y];

void main() {
    uint xtIdx = gl_LocalInvocationIndex * (2 * SAMPLE_COUNT);
    uint ytIdx = gl_WorkGroupID.x;

    int f = int(gl_WorkGroupID.y);

    ivec2 coordI = ivec2(xtIdx, ytIdx) * f + ivec2(ytIdx, xtIdx) * (f ^ 1);
    vec2 coordDelta = vec2(1.0, 0.0) * f + vec2(0.0, 1.0) * (f ^ 1);
    vec2 coord = (vec2(coordI) + 0.5 + coordDelta * 0.5) * TEXEL_SIZE;

    float value;
    #if SAMPLE_COUNT == 1
    value = texture(usam_imap2D, coord).r;
    #else
    value = 0.0;
    vec2 texelDelta = coordDelta * TEXEL_SIZE;
    for (int i = 0; i < SAMPLE_COUNT; i++) {
        value = max(value, texture(usam_imap2D, coord + texelDelta * float(i)).r);
    }
    #endif

    float maxValue1 = subgroupMax(value);
    if (gl_SubgroupInvocationID == 0u) {
        collapseBuffer[gl_SubgroupID] = maxValue1;
    }

    barrier();
    if (gl_SubgroupID != 0u) return;

    float v = gl_SubgroupInvocationID < gl_NumSubgroups ? collapseBuffer[gl_SubgroupInvocationID] : 0.0;
    float maxValue2 = subgroupMax(v);

    if (gl_SubgroupInvocationID == 0) {
        imageStore(uimg_imap1D, ivec2(gl_WorkGroupID.x, gl_WorkGroupID.y), vec4(maxValue2, 0.0, 0.0, 0.0));
    }
}
