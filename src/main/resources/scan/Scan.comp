#extension GL_KHR_shader_subgroup_arithmetic : enable

layout(std430) readonly buffer InputBuffer {
    uint ssbo_inputBuffer[];
};

layout(std430) writeonly buffer OutputBuffer {
    uint ssbo_outputBuffer[];
};

layout(std430) writeonly buffer AuxSumBuffer {
    uint ssbo_auxSumBuffer[];
};

struct DispatchIndirectCommand {
    uint num_groups_x;
    uint num_groups_y;
    uint num_groups_z;
    uint count;
};

layout(std140) uniform PassIndirect {
    DispatchIndirectCommand ubo_passIndirect[6];
};

uniform uint uval_pass;

layout(local_size_x = WORK_GROUP_SIZE) in;

shared uint shared_sum[WORK_GROUP_SIZE / 16];

void main() {
    uint sum = 0u;

    if (gl_GlobalInvocationID.x < ubo_passIndirect[uval_pass].count) {
        sum = ssbo_inputBuffer[gl_GlobalInvocationID.x];
    }

    sum = subgroupInclusiveAdd(sum);

    if (gl_SubgroupInvocationID == gl_SubgroupSize - 1) {
        shared_sum[gl_SubgroupID] = sum;
    }

    barrier();

    if (gl_SubgroupID == 0) {
        uint warpSum = gl_SubgroupInvocationID < gl_NumSubgroups ? shared_sum[gl_SubgroupInvocationID] : 0u;
        warpSum = subgroupInclusiveAdd(warpSum);
        shared_sum[gl_SubgroupInvocationID] = warpSum;
    }

    barrier();

    uint blockSum = 0u;
    if (gl_SubgroupID > 0) {
        blockSum = shared_sum[gl_SubgroupID - 1];
    }

    sum += blockSum;

    if (gl_GlobalInvocationID.x < ubo_passIndirect[uval_pass].count) {
        ssbo_outputBuffer[gl_GlobalInvocationID.x] = sum;
    }

    if (gl_WorkGroupID.x < gl_NumWorkGroups.x - 1 && gl_LocalInvocationID.x == gl_WorkGroupSize.x - 1) {
        ssbo_auxSumBuffer[gl_WorkGroupID.x] = sum;
    }
}
