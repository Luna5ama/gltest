#version 460 core
#extension GL_ARB_gpu_shader_int64 : enable

layout(local_size_x = 16, local_size_y = 16) in;

uniform usampler2D usam_vBufferDataTex;
uniform sampler2D usam_vBufferDepth;

layout(std430) writeonly buffer VBufferDepthQuadIndex {
    uint64_t ssbo_vBufferDepthQuadIndex[];
};

void main() {
    ivec2 outputSize = textureSize(usam_vBufferDataTex, 0);
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(coord, outputSize))) {
        return;
    }

    uint quadIndex = texelFetch(usam_vBufferDataTex, coord, 0).x;
    float depth = texelFetch(usam_vBufferDepth, coord, 0).r;

    uint bufferIndex = coord.y * outputSize.x + coord.x;
    ssbo_vBufferDepthQuadIndex[bufferIndex] = uint64_t(floatBitsToUint(depth)) << 32u | uint64_t(quadIndex);
}