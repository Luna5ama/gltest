#version 460 core

#extension GL_NV_shader_atomic_int64 : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_vote : enable

#extension GL_NV_gpu_shader5 : enable

#define CUTOUT

#include "../../vbuffer/VBuffers.glsl"
#include "../../GlobalCamera.glsl"
#include "../../utils/SWRUtils.glsl"
#include "../Chunks.glsl"

layout(local_size_x = WORKGROUP_SIZE) in;

uniform vec4 uval_viewportSize;
uniform ivec2 uval_viewportSizeI;

layout(std430) buffer VBufferDepthQuadIndex {
    int64_t ssbo_vBufferDepthQuadIndex[];
};


#ifdef OVERDRAW_DEBUG
layout(r32ui) uniform uimage2D uimg_overdrawCounter;
#endif

#ifdef DEBUG_QUAD_COUNT
layout(std430) buffer TempBuffer {
    uint v1;
    uint v2;
    uint v3;
    uint v4;
} ssbo_tempBuffer;
#endif

struct QuadBatchInfo {
    uint chunkIndex;
    uint first;
    uint count;
};

#ifdef CUTOUT
uniform sampler2D usam_blockAlbedoAtlas;

layout(std430) readonly buffer QuadTexCoordDataBuffer {
    uvec4 ssbo_quadTexCoordDataBuffer[];
};

layout(std430) readonly buffer QuadAttribIndexBuffer {
    uint ssbo_quadAttribIndexBuffer[];
};
#endif

layout(std430) readonly buffer QuadBatchInfoBuffer {
    uint batchCount;
    uint _padding1;
    uint _padding2;
    uint _padding3;
    QuadBatchInfo batches[];
} ssbo_quadBatchInfo;

layout(std430) readonly buffer BatchIndicesData {
    uint ssbo_batchIndicesData[];
};

layout(std430) readonly buffer QuadPosDataBuffer {
    uvec4 ssbo_quadPosDataBuffer[];
};

layout(std430) readonly buffer QuadPosIndexBuffer {
    uint ssbo_quadPosIndexBuffer[];
};

float min3(vec3 v) {
    return min(v.x, min(v.y, v.z));
}

float max3(vec3 v) {
    return max(v.x, max(v.y, v.z));
}

float min4(vec4 v) {
    return min(min(v.x, v.y), min(v.z, v.w));
}

float max4(vec4 v) {
    return max(max(v.x, v.y), max(v.z, v.w));
}

shared uvec2 shared_metaFirstCount;
shared uint shared_chunkIndex;
shared vec3 shared_chunkOffset;
shared uint shared_quadCount;
shared uint16_t shared_quadIndexOffset[QUADS_PER_WORK_GROUP];

const vec4 COORD_CONVERT = vec4(2.51773861295491E-4);

bool cullQuad(uint localQuadIndex) {
    uvec2 metaFirstCount = shared_metaFirstCount;
    uint metaFirst = metaFirstCount.x;
    uint metaCount = metaFirstCount.y;
    vec3 chunkOffset = shared_chunkOffset;

    if (localQuadIndex >= metaCount) {
        return false;
    }

    uint quadIndex = metaFirst + localQuadIndex;
    uint quadPosDataIdx = ssbo_quadPosIndexBuffer[quadIndex] * 2u;

    uvec4 data1 = ssbo_quadPosDataBuffer[quadPosDataIdx];
    uvec4 data2 = ssbo_quadPosDataBuffer[quadPosDataIdx + 1u];

    vec4 posXs = decodePos(data1.xy);
    vec4 posYs = decodePos(data1.zw);
    vec4 posZs = decodePos(data2.xy);

    posXs = posXs * COORD_CONVERT + chunkOffset.x;
    posYs = posYs * COORD_CONVERT + chunkOffset.y;
    posZs = posZs * COORD_CONVERT + chunkOffset.z;

    vec3 posCS1 = (ubo_cameraDefault.combined * vec4(posXs.x, posYs.x, posZs.x, 1.0)).xyw;
    vec3 posCS2 = (ubo_cameraDefault.combined * vec4(posXs.y, posYs.y, posZs.y, 1.0)).xyw;
    vec3 posCS3 = (ubo_cameraDefault.combined * vec4(posXs.z, posYs.z, posZs.z, 1.0)).xyw;
    vec3 posCS4 = (ubo_cameraDefault.combined * vec4(posXs.w, posYs.w, posZs.w, 1.0)).xyw;

    uint survived = uint(determinant(mat3(posCS1, posCS2, posCS3)) > 0.0);

    posCS1.xy /= posCS1.z;
    posCS2.xy /= posCS2.z;
    posCS3.xy /= posCS3.z;
    posCS4.xy /= posCS4.z;

    posCS1.xy = posCS1.xy * 0.5 + 0.5;
    posCS2.xy = posCS2.xy * 0.5 + 0.5;
    posCS3.xy = posCS3.xy * 0.5 + 0.5;
    posCS4.xy = posCS4.xy * 0.5 + 0.5;

    vec4 screenBoundF = clamp(
        vec4(
            min(posCS1.xy, min(posCS2.xy, min(posCS3.xy, posCS4.xy))),
            max(posCS1.xy, max(posCS2.xy, max(posCS3.xy, posCS4.xy)))
        ), 0.0, 1.0
    );
    screenBoundF *= uval_viewportSize.xyxy;
    uvec4 screenBound = uvec4(floor(screenBoundF.xy), ceil(screenBoundF.zw));
    survived = survived & uint(!any(equal(round(screenBoundF.xy), round(screenBoundF.zw))));
    survived = survived & uint(all(lessThan(screenBound.zw - screenBound.xy, uvec2(16))));

    return bool(survived);
}

void rasterize(uint baseLocalQuadIndex) {
    uint localQuadIndex = baseLocalQuadIndex + gl_LocalInvocationID.x;
    if (localQuadIndex < shared_quadCount) {
        int quadIndexOffset = int(shared_quadIndexOffset[localQuadIndex]);
        uint quadIndex = shared_metaFirstCount.x + uint(quadIndexOffset);

        #ifdef CUTOUT
        uvec4 texCoordXY = ssbo_quadTexCoordDataBuffer[ssbo_quadAttribIndexBuffer[quadIndex]];
        #endif

        uint quadPosDataIdx = ssbo_quadPosIndexBuffer[quadIndex] * 2u;

        uvec4 data1 = ssbo_quadPosDataBuffer[quadPosDataIdx];
        uvec4 data2 = ssbo_quadPosDataBuffer[quadPosDataIdx + 1u];

        vec4 posXs = decodePos(data1.xy);
        vec4 posYs = decodePos(data1.zw);
        vec4 posZs = decodePos(data2.xy);

        posXs = posXs * COORD_CONVERT + shared_chunkOffset.x;
        posYs = posYs * COORD_CONVERT + shared_chunkOffset.y;
        posZs = posZs * COORD_CONVERT + shared_chunkOffset.z;

        vec4 posCS1 = (ubo_cameraDefault.combined * vec4(posXs.x, posYs.x, posZs.x, 1.0));
        vec4 posCS2 = (ubo_cameraDefault.combined * vec4(posXs.y, posYs.y, posZs.y, 1.0));
        vec4 posCS3 = (ubo_cameraDefault.combined * vec4(posXs.z, posYs.z, posZs.z, 1.0));
        vec4 posCS4 = (ubo_cameraDefault.combined * vec4(posXs.w, posYs.w, posZs.w, 1.0));

        posCS1.xyz /= posCS1.w;
        posCS2.xyz /= posCS2.w;
        posCS3.xyz /= posCS3.w;
        posCS4.xyz /= posCS4.w;

        posCS1.xy = posCS1.xy * 0.5 + 0.5;
        posCS2.xy = posCS2.xy * 0.5 + 0.5;
        posCS3.xy = posCS3.xy * 0.5 + 0.5;
        posCS4.xy = posCS4.xy * 0.5 + 0.5;

        posZs = vec4(posCS1.z, posCS2.z, posCS3.z, posCS4.z);

        vec4 screenBoundF = clamp(
            vec4(
                min(posCS1.xy, min(posCS2.xy, min(posCS3.xy, posCS4.xy))),
                max(posCS1.xy, max(posCS2.xy, max(posCS3.xy, posCS4.xy)))
            ), 0.0, 1.0
        );
        screenBoundF *= uval_viewportSize.xyxy;
        ivec4 screenBound = ivec4(floor(screenBoundF.xy), ceil(screenBoundF.zw));
        screenBoundF = vec4(screenBound);
        vec2 texelNF = screenBoundF.zw - screenBoundF.xy;
        vec2 invTexelN = 1.0 / texelNF;
        screenBoundF *= uval_viewportSize.zwzw;

        vec4 t1bBase, t1bDx, t1bDy;
        swr_calcBarycentricGrad(screenBoundF, invTexelN, posCS1.xy, posCS2.xy, posCS3.xy, t1bBase.xyz, t1bDx.xyz, t1bDy.xyz);
        t1bBase.xyz += (t1bDx.xyz + t1bDy.xyz) * 0.5;

        vec4 t2bBase, t2bDx, t2bDy;
        swr_calcBarycentricGrad(screenBoundF, invTexelN, posCS3.xy, posCS4.xy, posCS1.xy, t2bBase.xyz, t2bDx.xyz, t2bDy.xyz);
        t2bBase.xyz += (t2bDx.xyz + t2bDy.xyz) * 0.5;

        i64vec4 valueVec;
        ivec4 outputCoord;
        vec4 t1b = t1bBase;
        vec4 t2b = t2bBase;
        valueVec.w = int64_t(quadIndex << 1u);

        if (false) {
            for (outputCoord.y = screenBound.y; outputCoord.y < screenBound.w; outputCoord.y++) {
                vec3 t1bDxInv;
                t1bDxInv = mix(
                    vec3(1e8),
                    vec3(1.0) / t1bDx.xyz,
                    notEqual(t1bDx.xyz, vec3(0.0))
                );
                vec3 t1CrossX = t1b.xyz * -t1bDxInv;

                bvec3 t1OpenEdge = greaterThan(t1bDx.xyz, vec3(0.0));
                vec3 t1MinX = mix(vec3(0.0), t1CrossX, t1OpenEdge);
                vec3 t1MaxX = mix(t1CrossX, vec3(screenBound.z - screenBound.x), t1OpenEdge);

                ivec4 tx;
                tx.x = int(ceil(max3(t1MinX)));
                tx.y = int(floor(min3(t1MaxX)));


                vec3 t2bDxInv;
                t2bDxInv = mix(
                    vec3(1e8),
                    vec3(1.0) / t2bDx.xyz,
                    notEqual(t2bDx.xyz, vec3(0.0))
                );
                vec3 t2CrossX = t2b.xyz * -t2bDxInv;

                bvec3 t2OpenEdge = greaterThan(t2bDx.xyz, vec3(0.0));
                vec3 t2MinX = mix(vec3(0.0), t2CrossX, t2OpenEdge);
                vec3 t2MaxX = mix(t2CrossX, vec3(screenBound.z - screenBound.x), t2OpenEdge);

                tx.z = int(ceil(max3(t2MinX)));
                tx.w = int(floor(min3(t2MaxX)));

                tx.x = min(tx.x, tx.z);
                tx.y = max(tx.y, tx.w);

                vec3 t1bX = t1b.xyz + tx.x * t1bDx.xyz;
                vec3 t2bX = t2b.xyz + tx.x * t2bDx.xyz;

                tx.xy += screenBound.xx;
                tx.xy = clamp(tx.xy, screenBound.xx, screenBound.zz);

                for (outputCoord.x = tx.x; outputCoord.x <= tx.y; outputCoord.x++) {
                    if (any(bvec2(all(greaterThanEqual(t1bX, vec3(0.0))), all(greaterThanEqual(t2bX, vec3(0.0)))))) {
                        #ifdef CUTOUT
                        vec4 texCoordX = vec4(
                            unpackUnorm2x16(texCoordXY.x),
                            unpackUnorm2x16(texCoordXY.y)
                        );
                        vec4 texCoordY = vec4(
                            unpackUnorm2x16(texCoordXY.z),
                            unpackUnorm2x16(texCoordXY.w)
                        );
                        vec4 texCoord12 = vec4(
                            dot(texCoordX.xyz, t1bX),
                            dot(texCoordY.xyz, t1bX),
                            dot(texCoordX.zwx, t2bX),
                            dot(texCoordY.zwx, t2bX)
                        );
                        #endif

                        outputCoord.z = outputCoord.y * uval_viewportSizeI.x + outputCoord.x;
                        valueVec.x = ssbo_vBufferDepthQuadIndex[outputCoord.z];
                        valueVec.y = (int64_t(floatBitsToInt(dot(posZs.xyz, t1bX))) << 32) | valueVec.w;
                        valueVec.z = (int64_t(floatBitsToInt(dot(posZs.zwx, t2bX))) << 32) | valueVec.w | 1;

                        #ifdef CUTOUT
                        if (all(bvec3(all(greaterThanEqual(t1bX, vec3(0.0))), texture(usam_blockAlbedoAtlas, texCoord12.xy).a > 0.5, valueVec.y >= valueVec.x)))
                        #else
                        if (all(greaterThanEqual(t1bX, vec3(0.0))) && valueVec.y >= valueVec.x)
                        #endif
                        {
                            #ifdef OVERDRAW_DEBUG
                            if (atomicMax(ssbo_vBufferDepthQuadIndex[outputCoord.z], valueVec.y) <= valueVec.y) {
                                imageAtomicAdd(uimg_overdrawCounter, outputCoord.xy, 1u);
                            }
                            #else
                            atomicMax(ssbo_vBufferDepthQuadIndex[outputCoord.z], valueVec.y);
                            #endif
                        }


                        #ifdef CUTOUT
                        if (all(bvec3(all(greaterThanEqual(t2bX, vec3(0.0))), texture(usam_blockAlbedoAtlas, texCoord12.zw).a > 0.5, valueVec.z >= valueVec.x)))
                        #else
                        if (all(greaterThanEqual(t2bX, vec3(0.0))) && valueVec.z >= valueVec.x)
                        #endif
                        {
                            #ifdef OVERDRAW_DEBUG
                            if (atomicMax(ssbo_vBufferDepthQuadIndex[outputCoord.z], valueVec.z) <= valueVec.z) {
                                imageAtomicAdd(uimg_overdrawCounter, outputCoord.xy, 1u);
                            }
                            #else
                            atomicMax(ssbo_vBufferDepthQuadIndex[outputCoord.z], valueVec.z);
                            #endif
                        }
                    }
                    t1bX += t1bDx.xyz;
                    t2bX += t2bDx.xyz;
                }

                t1b.xyz += t1bDy.xyz;
                t2b.xyz += t2bDy.xyz;
            }
        } else {
            t1bDy.xyz -= t1bDx.xyz * texelNF.x;
            t2bDy.xyz -= t2bDx.xyz * texelNF.x;
            for (outputCoord.y = screenBound.y; outputCoord.y < screenBound.w; outputCoord.y++) {
                for (outputCoord.x = screenBound.x; outputCoord.x < screenBound.z; outputCoord.x++) {
                    if (any(bvec2(all(greaterThanEqual(t1b.xyz, vec3(0.0))), all(greaterThanEqual(t2b.xyz, vec3(0.0)))))) {
                        outputCoord.z = outputCoord.y * uval_viewportSizeI.x + outputCoord.x;
                        valueVec.x = ssbo_vBufferDepthQuadIndex[outputCoord.z];
                        valueVec.y = (int64_t(floatBitsToInt(dot(posZs.xyz, t1b.xyz))) << 32) | int64_t(quadIndex << 1u);
                        valueVec.z = (int64_t(floatBitsToInt(dot(posZs.zwx, t2b.xyz))) << 32) | int64_t((quadIndex << 1u) | 1u);
                        #ifdef CUTOUT
                        vec4 texCoordX = vec4(
                            unpackUnorm2x16(texCoordXY.x),
                            unpackUnorm2x16(texCoordXY.y)
                        );
                        vec4 texCoordY = vec4(
                            unpackUnorm2x16(texCoordXY.z),
                            unpackUnorm2x16(texCoordXY.w)
                        );
                        vec2 texCoord1 = vec2(dot(texCoordX.xyz, t1b.xyz), dot(texCoordY.xyz, t1b.xyz));
                        vec2 texCoord2 = vec2(dot(texCoordX.zwx, t2b.xyz), dot(texCoordY.zwx, t2b.xyz));
                        #endif

                        #ifdef CUTOUT
                        if (all(bvec3(all(greaterThanEqual(t1b.xyz, vec3(0.0))), texture(usam_blockAlbedoAtlas, texCoord1).a > 0.5, valueVec.y >= valueVec.x)))
                        #else
                        if (all(greaterThanEqual(t1b.xyz, vec3(0.0))) && valueVec.y >= valueVec.x)
                        #endif
                        {
                            #ifdef OVERDRAW_DEBUG
                            if (atomicMax(ssbo_vBufferDepthQuadIndex[outputCoord.z], valueVec.y) <= valueVec.y) {
                                imageAtomicAdd(uimg_overdrawCounter, outputCoord.xy, 1u);
                            }
                            #else
                            atomicMax(ssbo_vBufferDepthQuadIndex[outputCoord.z], valueVec.y);
                            #endif
                        }

                        #ifdef CUTOUT
                        if (all(bvec3(all(greaterThanEqual(t2b.xyz, vec3(0.0))), texture(usam_blockAlbedoAtlas, texCoord2).a > 0.5, valueVec.z >= valueVec.x)))
                        #else
                        if (all(greaterThanEqual(t2b.xyz, vec3(0.0))) && valueVec.z >= valueVec.x)
                        #endif
                        {
                            #ifdef OVERDRAW_DEBUG
                            if (atomicMax(ssbo_vBufferDepthQuadIndex[outputCoord.z], valueVec.z) <= valueVec.z) {
                                imageAtomicAdd(uimg_overdrawCounter, outputCoord.xy, 1u);
                            }
                            #else
                            atomicMax(ssbo_vBufferDepthQuadIndex[outputCoord.z], valueVec.z);
                            #endif
                        }
                    }
                    t1b.xyz += t1bDx.xyz;
                    t2b.xyz += t2bDx.xyz;
                }
                t1b.xyz += t1bDy.xyz;
                t2b.xyz += t2bDy.xyz;
            }
        }
    }
}

void setup(uint baseLocalQuadIndex) {
    uint localQuadIndex = baseLocalQuadIndex + gl_LocalInvocationID.x;
    if (localQuadIndex < shared_metaFirstCount.y) {
        bool survived = cullQuad(localQuadIndex);

        uvec4 ballot = subgroupBallot(survived);

        uint quadWriteBaseIdx;

        if (gl_SubgroupInvocationID == 0u) {
            quadWriteBaseIdx = atomicAdd(shared_quadCount, subgroupBallotBitCount(ballot));
        }

        quadWriteBaseIdx = subgroupBroadcast(quadWriteBaseIdx, 0u);

        if (survived) {
            shared_quadIndexOffset[quadWriteBaseIdx + subgroupBallotExclusiveBitCount(ballot)] = uint16_t(localQuadIndex);
        }
    }
}

void init() {
    uint batchIndex = ssbo_batchIndicesData[gl_WorkGroupID.x];
    QuadBatchInfo batchMetadata = ssbo_quadBatchInfo.batches[batchIndex];
    uint chunkIndex = batchMetadata.chunkIndex;
    shared_metaFirstCount = uvec2(batchMetadata.first, batchMetadata.count);
    shared_chunkIndex = chunkIndex;
    vec3 chunkOffset = chunks_getChunkRenderPos(chunkIndex);
    shared_chunkOffset = chunkOffset;

    shared_quadCount = 0u;
}

void clear() {
    uint xd = gl_LocalInvocationID.x << 1u;
    shared_quadIndexOffset[xd] = uint16_t(0);
    shared_quadIndexOffset[xd + 1u] = uint16_t(0);
}

void main() {
    if (gl_LocalInvocationID.x == 0u){
        init();
        #ifdef DEBUG_QUAD_COUNT
        atomicAdd(ssbo_tempBuffer.v1, shared_metaFirstCount.y);
        #endif
    }
    clear();
    barrier();

    uint setupIter = (shared_metaFirstCount.y + WORKGROUP_SIZE - 1) / WORKGROUP_SIZE;

    for (uint i = 0u; i < setupIter; i++) {
        setup(i * gl_WorkGroupSize.x);
    }

    barrier();

    uint rasterizeIter = (shared_quadCount + WORKGROUP_SIZE - 1) / WORKGROUP_SIZE;

    for (uint i = 0u; i < rasterizeIter; i++) {
        rasterize(i * gl_WorkGroupSize.x);
    }

    #ifdef DEBUG_QUAD_COUNT
    if (gl_LocalInvocationID.x == 0u){
        atomicAdd(ssbo_tempBuffer.v2, shared_quadCount);
    }
    #endif
}
