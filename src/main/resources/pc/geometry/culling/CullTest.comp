#version 460 core

#if FLAG_TYPE == uint8_t
#extension GL_NV_gpu_shader5 : enable
#elif FLAG_TYPE == uint16_t
#extension GL_AMD_gpu_shader_int16 : enable
#endif

#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_vote : enable

#define WORKGROUP_SIZE 128

layout(local_size_x = WORKGROUP_SIZE) in;

uniform ivec2 uval_viewportSizeI;

layout(std430) readonly buffer VBufferDepthQuadIndex {
    uint64_t ssbo_vBufferDepthQuadIndex[];
};

struct CullTestQuad {
    uvec4 screenBounds_ChunkIndex;
    vec4 depths;
    vec4 t1bBase;
    vec4 t1bDx;
    vec4 t1bDy;
    vec4 t2bBase;
    vec4 t2bDx;
    vec4 t2bDy;
};

layout(std430) buffer CullTestQuadBuffer {
    uint lastOffset;
    uint _padding1;
    uint _padding2;
    uint _padding3;
    CullTestQuad data[];
} ssbo_cullTestQuadBuffer;

layout(std430) buffer VisibleBuffer {
    uint lastOffset;
    uint _padding1;
    uint _padding2;
    uint _padding3;
    FLAG_TYPE states[];
} ssbo_visibleBuffer;

float min3(vec3 v) {
    return min(v.x, min(v.y, v.z));
}

//shared uint shared_visible;

void main() {
//    shared_visible = 0u;

    CullTestQuad data = ssbo_cullTestQuadBuffer.data[gl_WorkGroupID.x * gl_NumSubgroups + gl_SubgroupID];
    uint chunkIndex = data.screenBounds_ChunkIndex.z;

    ivec4 screenBounds = ivec4((data.screenBounds_ChunkIndex.xxyy >> uvec4(0u, 16u, 0u, 16u)) & uvec4(0xFFFFu));
    vec3 t1bBase = data.t1bBase.xyz;
    vec3 t1bDx = data.t1bDx.xyz;
    vec3 t1bDy = data.t1bDy.xyz;
    vec3 t1bZ = data.depths.xyz;

    vec3 t2bBase = data.t2bBase.xyz;
    vec3 t2bDx = data.t2bDx.xyz;
    vec3 t2bDy = data.t2bDy.xyz;
    vec3 t2bZ = data.depths.zyw;

    ivec3 boundSize_temp = ivec3(screenBounds.zw - screenBounds.xy, 0);
    uint totalPixels = boundSize_temp.x * boundSize_temp.y;
    uint totalPixelsPerThread = (totalPixels + gl_SubgroupSize  - 1) / gl_SubgroupSize ;

//    if (totalPixels > 0){
//        ssbo_visibleBuffer.states[chunkIndex] = FLAG_TYPE(1u);
//    }

    if (uint(ssbo_visibleBuffer.states[chunkIndex]) == 1u) return;

    for (uint i = 0u; i < totalPixelsPerThread; i++) {
        uint pixelIdx = gl_SubgroupInvocationID * totalPixelsPerThread + i;
        if (pixelIdx >= totalPixels) break;

        ivec2 pixelXYI = ivec2(pixelIdx % boundSize_temp.x, pixelIdx / boundSize_temp.x);
        vec2 pixelXY = vec2(pixelXYI);
        ivec2 pixelPosI = screenBounds.xy + pixelXYI;

        vec3 t1b = t1bBase + t1bDx * pixelXY.x + t1bDy * pixelXY.y;
        vec3 t2b = t2bBase + t2bDx * pixelXY.x + t2bDy * pixelXY.y;

        float srcDepth1 = dot(t1bZ, t1b);
        float srcDepth2 = dot(t2bZ, t2b);
//        float dstDepth = texelFetch(usam_vBufferDepth, pixelPosI, 0).r;
        boundSize_temp.z = pixelPosI.y * uval_viewportSizeI.x + pixelPosI.x;
        float dstDepth = uintBitsToFloat(uint(ssbo_vBufferDepthQuadIndex[boundSize_temp.z] >> 32u));

        bool vote = subgroupAny(min3(t1b) >= 0.0 && srcDepth1 > dstDepth || min3(t2b) >= 0.0 && srcDepth2 > dstDepth);

        if (vote) {
            if (subgroupElect()) {
                ssbo_visibleBuffer.states[chunkIndex] = FLAG_TYPE(1u);
            }
            break;
        }
    }
}