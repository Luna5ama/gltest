#version 460 core

#extension GL_KHR_shader_subgroup_clustered : enable
#extension GL_ARB_gpu_shader_int64 : enable

layout(local_size_x = 128) in;

uniform ivec2 uval_viewportSizeI;
uniform ivec2 uval_clusterCount;

layout(r32f) uniform writeonly image2D uimg_cullTempTex;

layout(std430) readonly buffer VBufferDepthQuadIndex {
    uint64_t ssbo_vBufferDepthQuadIndex[];
};

void main() {
    int clusterIndex = int(gl_GlobalInvocationID.x >> 4u);
    ivec2 clusterCoord = ivec2(clusterIndex % uval_clusterCount.x, clusterIndex / uval_clusterCount.x);

    int readGroupIndex = int(gl_GlobalInvocationID.x & 0xFu);
    ivec2 readCoord = (clusterCoord << ivec2(2)) + ivec2(readGroupIndex & 3, readGroupIndex >> 2);

    float depth = 0.0;
    if (all(bvec2(all(lessThan(readCoord, uval_viewportSizeI)), all(greaterThanEqual(readCoord, ivec2(0)))))) {
        uint64_t dataRaw = ssbo_vBufferDepthQuadIndex[readCoord.y * uval_viewportSizeI.x + readCoord.x];
        depth = uintBitsToFloat(uint(dataRaw >> 32));
    }

    float outputDepth = subgroupClusteredMin(depth, 16u);

    if (readGroupIndex == 0u) {
        imageStore(uimg_cullTempTex, clusterCoord, vec4(outputDepth, 0.0, 0.0, 0.0));
    }
}