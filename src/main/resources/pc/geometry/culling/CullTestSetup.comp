#version 460 core

#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_ballot : enable

#include "../../vbuffer/VBuffers.glsl"
#include "../../GlobalCamera.glsl"
#include "../../utils/SWRUtils.glsl"
#include "../Chunks.glsl"

layout(local_size_x = 128) in;

struct CullTestQuad {
    uvec4 screenBounds_ChunkIndex;
    vec4 depths;
    vec4 t1bBase;
    vec4 t1bDx;
    vec4 t1bDy;
    vec4 t2bBase;
    vec4 t2bDx;
    vec4 t2bDy;
};

layout(std430) buffer CullTestQuadBuffer {
    uint num_groups_x;
    uint num_groups_y;
    uint num_groups_z;
    uint count;
    CullTestQuad data[];
} ssbo_cullTestQuadBuffer;

struct CullTestCommand {
    uint chunkIndex;
};

layout(std430) readonly buffer CullTestCommandBuffer {
    uint num_groups_x;
    uint num_groups_y;
    uint num_groups_z;
    uint count;
    CullTestCommand commands[];
} ssbo_cullTestCommandBuffer;

uniform vec3 uval_originOffset;
uniform vec4 uval_viewportSize;

const uvec3 CHUNK_OFFSET_BITMASK = (uvec3(1u) << uvec3(13u, 6u, 13u)) - uvec3(1u);
const uvec3 CHUNK_OFFSET_BITSHIFT = uvec3(0u, 13u, 13u + 6u);

const vec3 BOX_VERT_POS[8] = {
vec3(-1.0, -1.0, -1.0), // 0
vec3(17.0, -1.0, -1.0), // 1
vec3(-1.0, -1.0, 17.0), // 2
vec3(17.0, -1.0, 17.0), // 3
vec3(-1.0, 17.0, -1.0), // 4
vec3(17.0, 17.0, -1.0), // 5
vec3(-1.0, 17.0, 17.0), // 6
vec3(17.0, 17.0, 17.0)// 7
};

const uint BOX_VERT_INDICES[24] = {
// Left face
0, 2, 4, 6,
// Right face
1, 5, 3, 7,
// Bottom face
0, 1, 2, 3,
// Top face
4, 6, 5, 7,
// Back face
1, 0, 5, 4,
// Front face
3, 7, 2, 6
};

const float EPSILON = 1e-6;

bool setupCull(out CullTestQuad data) {
    if ((gl_GlobalInvocationID.x / 6) > ssbo_cullTestCommandBuffer.count) {
        return false;
    }

    uint survived = 1u;

    CullTestCommand command = ssbo_cullTestCommandBuffer.commands[gl_GlobalInvocationID.x / 6u];
    data.screenBounds_ChunkIndex.z = command.chunkIndex;
    data.screenBounds_ChunkIndex.w = gl_GlobalInvocationID.x;
    vec3 chunkOffset = chunks_getChunkRenderPos(data.screenBounds_ChunkIndex.z);

    uint indicesBaseIdx = (gl_GlobalInvocationID.x % 6u) * 4u;

    vec3 pos1 = BOX_VERT_POS[BOX_VERT_INDICES[indicesBaseIdx + 0]] + chunkOffset;
    vec3 pos2 = BOX_VERT_POS[BOX_VERT_INDICES[indicesBaseIdx + 1]] + chunkOffset;
    vec3 pos3 = BOX_VERT_POS[BOX_VERT_INDICES[indicesBaseIdx + 2]] + chunkOffset;
    vec3 pos4 = BOX_VERT_POS[BOX_VERT_INDICES[indicesBaseIdx + 3]] + chunkOffset;

    vec4 clipPos1 = ubo_cameraDefault.combined * vec4(pos1, 1.0);
    vec4 clipPos2 = ubo_cameraDefault.combined * vec4(pos2, 1.0);
    vec4 clipPos3 = ubo_cameraDefault.combined * vec4(pos3, 1.0);
    vec4 clipPos4 = ubo_cameraDefault.combined * vec4(pos4, 1.0);

    survived = survived & (uint(determinant(mat3(clipPos1.xyw, clipPos2.xyw, clipPos3.xyw)) > 0.0) | uint(determinant(mat3(clipPos3.xyw, clipPos2.xyw, clipPos4.xyw)) > 0.0));

    vec4 clipPosZ = vec4(clipPos1.z, clipPos2.z, clipPos3.z, clipPos4.z);
    vec4 clipPosW = vec4(clipPos1.w, clipPos2.w, clipPos3.w, clipPos4.w);

    data.depths = clipPosZ / clipPosW;

    vec2 screenPos1 = clipPos1.xy / clipPos1.w;
    vec2 screenPos2 = clipPos2.xy / clipPos2.w;
    vec2 screenPos3 = clipPos3.xy / clipPos3.w;
    vec2 screenPos4 = clipPos4.xy / clipPos4.w;

    screenPos1 = screenPos1 * 0.5 + 0.5;
    screenPos2 = screenPos2 * 0.5 + 0.5;
    screenPos3 = screenPos3 * 0.5 + 0.5;
    screenPos4 = screenPos4 * 0.5 + 0.5;

    vec4 screenBoundF = clamp(
        vec4(
            min(min(screenPos1.xy, screenPos2.xy), min(screenPos3.xy, screenPos4.xy)),
            max(max(screenPos1.xy, screenPos2.xy), max(screenPos3.xy, screenPos4.xy))
        ), 0.0, 1.0
    );

    screenBoundF *= uval_viewportSize.xyxy;
//    survived = survived & uint(!any(equal(round(screenBoundF.xy), round(screenBoundF.zw))));

    ivec4 screenBound = ivec4(floor(screenBoundF.xy), ceil(screenBoundF.zw));
    data.screenBounds_ChunkIndex.x = (uint(screenBound.x) & 0xFFFFu) | ((uint(screenBound.y) & 0xFFFFu) << 16u);
    data.screenBounds_ChunkIndex.y = (uint(screenBound.z) & 0xFFFFu) | ((uint(screenBound.w) & 0xFFFFu) << 16u);
    screenBoundF = vec4(screenBound);
    vec2 texelNF = screenBoundF.zw - screenBoundF.xy;
    vec2 invTexelN = 1.0 / texelNF;
    screenBoundF *= uval_viewportSize.zwzw;

    swr_calcBarycentricGrad(screenBoundF, invTexelN, screenPos1, screenPos2, screenPos3, data.t1bBase.xyz, data.t1bDx.xyz, data.t1bDy.xyz);
    data.t1bBase += (data.t1bDx + data.t1bDy) * 0.5;

    swr_calcBarycentricGrad(screenBoundF, invTexelN, screenPos3, screenPos2, screenPos4, data.t2bBase.xyz, data.t2bDx.xyz, data.t2bDy.xyz);
    data.t2bBase += (data.t2bDx + data.t2bDy) * 0.5;

    return bool(survived);
}

void main() {
    CullTestQuad data;
    bool survived = setupCull(data);

    uvec4 ballot = subgroupBallot(survived);
    uint subgroupCount = subgroupBallotBitCount(ballot);

    uint dataWriteBaseIdx = 0u;

    if (subgroupElect()) {
        dataWriteBaseIdx = atomicAdd(ssbo_cullTestQuadBuffer.count, subgroupCount);
    }

    dataWriteBaseIdx = subgroupMax(dataWriteBaseIdx);

    if (survived) {
        uint dataWriteIdx = dataWriteBaseIdx + subgroupBallotExclusiveBitCount(ballot);
        ssbo_cullTestQuadBuffer.data[dataWriteIdx] = data;
    }
}