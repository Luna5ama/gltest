#version 460 core

#if FLAG_TYPE == uint8_t
#extension GL_NV_gpu_shader5 : enable
#elif FLAG_TYPE == uint16_t
#extension GL_AMD_gpu_shader_int16 : enable
#endif

#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

#include "../../GlobalCamera.glsl"
#include "../Chunks.glsl"

layout(local_size_x = 256) in;

struct DrawElementsIndirectCommand {
    uint count;
    uint instanceCount;
    uint firstIndex;
    int baseVertex;
    uint baseInstance;
};

layout(std430) readonly buffer InputIndirectBuffer {
    uint commandCount;
    uint _padding1;
    uint _padding2;
    uint _padding3;
    DrawElementsIndirectCommand commands[];
} ssbo_inputIndirectBuffer;

layout(std430) buffer OutputIndirectBuffer {
    uint commandCount;
    uint _padding1;
    uint _padding2;
    uint _padding3;
    DrawElementsIndirectCommand commands[];
} ssbo_outputIndirectBuffer;

layout(std430) readonly buffer VisibleBuffer {
    uint lastOffset;
    uint _padding1;
    uint _padding2;
    uint _padding3;
    FLAG_TYPE states[];
} ssbo_visibleBuffer;

void main() {
    bool valid = false;
    if (gl_GlobalInvocationID.x < ssbo_inputIndirectBuffer.commandCount) {
        DrawElementsIndirectCommand command = ssbo_inputIndirectBuffer.commands[gl_GlobalInvocationID.x];
        uint chunkIndex = command.baseInstance;
        vec3 chunkOffset = chunks_getChunkRenderPos(chunkIndex);

        #if defined(VISIBILITY_STATE_LAST_VISIBLE)
        bool isCameraChunk = dot(chunkOffset, chunkOffset) < 1024.0;
        bool last = bool(ssbo_visibleBuffer.states[chunkIndex + ssbo_visibleBuffer.lastOffset]) || isCameraChunk;
        valid = last;

        #elif defined(VISIBILITY_STATE_NEWLY_VISIBLE)
        bool last = bool(ssbo_visibleBuffer.states[chunkIndex + ssbo_visibleBuffer.lastOffset]);
        bool curr = bool(ssbo_visibleBuffer.states[chunkIndex]);
        valid = !last && curr;

        #elif defined(VISIBILITY_STATE_CURRENT_VISIBLE)
        bool isCameraChunk = dot(chunkOffset, chunkOffset) < 1024.0;
        bool curr = bool(ssbo_visibleBuffer.states[chunkIndex]) || isCameraChunk;
        valid = curr;

        #else
        valid = true;

        #endif

    }

    uvec4 ballot = subgroupBallot(valid);

    uint writeBaseIndex = 0u;

    if (gl_SubgroupInvocationID == 0u) {
        writeBaseIndex = atomicAdd(ssbo_outputIndirectBuffer.commandCount, subgroupBallotBitCount(ballot));
    }

    writeBaseIndex = subgroupMax(writeBaseIndex);

    if (valid) {
        uint writeIndex = writeBaseIndex + subgroupBallotExclusiveBitCount(ballot);
        ssbo_outputIndirectBuffer.commands[writeIndex] = ssbo_inputIndirectBuffer.commands[gl_GlobalInvocationID.x];
    }
}