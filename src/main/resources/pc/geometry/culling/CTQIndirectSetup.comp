#version 460 core

layout(local_size_x = 1) in;

layout(std430) restrict buffer CullTestQuadBuffer {
    uint num_groups_x;
    uint num_groups_y;
    uint num_groups_z;
    uint count;
} ssbo_cullTestQuadBuffer;

void main() {
    ssbo_cullTestQuadBuffer.num_groups_x = (ssbo_cullTestQuadBuffer.count + N_GROUPS - 1u) / N_GROUPS;
    ssbo_cullTestQuadBuffer.num_groups_y = 1;
    ssbo_cullTestQuadBuffer.num_groups_z = 1;
    ssbo_cullTestQuadBuffer.count = 0;
}