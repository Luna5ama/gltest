#version 460 core

#extension GL_ARB_gpu_shader_int64 : enable
#extension GL_NV_shader_atomic_int64 : enable
#extension GL_KHR_shader_subgroup_ballot : enable

#if uint_least8_t == uint8_t
#extension GL_NV_gpu_shader5 : enable
#elif uint_least8_t == uint16_t
#extension GL_AMD_gpu_shader_int16 : enable
#endif

#define CUTOUT

#include "../vbuffer/VBuffers.glsl"
#include "../GlobalCamera.glsl"
#include "../utils/SWRUtils.glsl"

layout(local_size_x = WORKGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

uniform vec3 uval_originOffset;
uniform vec4 uval_viewportSize;
uniform ivec2 uval_viewportSizeI;

layout(std430) buffer VBufferDepthQuadIndex {
    int64_t ssbo_vBufferDepthQuadIndex[];
};

layout(r32ui) uniform writeonly uimage2D uimg_vBufferTex1;
#ifdef OVERDRAW_DEBUG
layout(r32ui) uniform writeonly uimage2D uimg_overdrawCounter;
#endif

struct QuadBatchInfo {
    uint first;
    uint count;
    uint offsetEncoded;
};

#ifdef CUTOUT
uniform sampler2D usam_blockAlbedoAtlas;

layout(std430) readonly buffer QuadTexCoordDataBuffer {
    uint ssbo_quadTexCoordDataBuffer[];
};

layout(std430) readonly buffer QuadAttribIndexBuffer {
    uint ssbo_quadAttribIndexBuffer[];
};
#endif

layout(std430) restrict readonly buffer QuadBatchInfoBuffer {
    QuadBatchInfo ssbo_quadBatchInfoBuffer[];
};

layout(std430) restrict readonly buffer QuadPosDataBuffer {
    uint ssbo_quadPosDataBuffer[];
};

layout(std430) restrict readonly buffer QuadPosIndexBuffer {
    uint ssbo_quadPosIndexBuffer[];
};

layout(std430) writeonly buffer TempBuffer {
    uint ssbo_tempBuffer[];
};

uvec2 readPosData(uint idx) {
    uint data1 = ssbo_quadPosDataBuffer[idx];
    uint data2 = ssbo_quadPosDataBuffer[idx + 1];
    return uvec2(data1, data2);
}

const uvec4 DECODE_POS_SHIFT = uvec4(0u, 16u, 0u, 16u);
const uvec4 DECODE_POS_MASK = uvec4(0xFFFFu);
vec4 decodePos(uvec2 data) {
    return vec4(uvec4((data.xxyy >> DECODE_POS_SHIFT) & DECODE_POS_MASK));
}

float min3(vec3 v) {
    return min(v.x, min(v.y, v.z));
}

float min4(vec4 v) {
    return min(min(v.x, v.y), min(v.z, v.w));
}

float max4(vec4 v) {
    return max(max(v.x, v.y), max(v.z, v.w));
}

shared uvec2 shared_metaFirstCount;
shared vec3 shared_chunkOffset;
shared uint shared_quadCount = 0u;
shared uint16_t shared_quadIndexOffset[QUADS_PER_WORK_GROUP];

const vec4 coordConvert = vec4(2.51773861295491E-4);

bool cullQuad(uint localQuadIndex) {
    uvec2 metaFirstCount = shared_metaFirstCount;
    uint metaFirst = metaFirstCount.x;
    uint metaCount = metaFirstCount.y;
    vec3 chunkOffset = shared_chunkOffset;

    if (localQuadIndex >= metaCount) {
        return false;
    }

    uint survived = 1;

    uint quadIndex = metaFirst + localQuadIndex;
    uint quadPosDataIdx = ssbo_quadPosIndexBuffer[quadIndex] * 6u;

    vec4 posX = decodePos(readPosData(quadPosDataIdx));
    vec4 posY = decodePos(readPosData(quadPosDataIdx + 2u));
    vec4 posZ = decodePos(readPosData(quadPosDataIdx + 4u));

    posX = posX * coordConvert + chunkOffset.x;
    posY = posY * coordConvert + chunkOffset.y;
    posZ = posZ * coordConvert + chunkOffset.z;

    vec3 pos1 = (ubo_cameraDefault.combined * vec4(posX.x, posY.x, posZ.x, 1.0)).xyw;
    vec3 pos2 = (ubo_cameraDefault.combined * vec4(posX.y, posY.y, posZ.y, 1.0)).xyw;
    vec3 pos3 = (ubo_cameraDefault.combined * vec4(posX.z, posY.z, posZ.z, 1.0)).xyw;
    vec3 pos4 = (ubo_cameraDefault.combined * vec4(posX.w, posY.w, posZ.w, 1.0)).xyw;

    survived = survived & uint(determinant(mat3(pos1, pos2, pos3)) > 0.0);

    posX = vec4(pos1.x, pos2.x, pos3.x, pos4.x);
    posY = vec4(pos1.y, pos2.y, pos3.y, pos4.y);
    posZ = vec4(pos1.z, pos2.z, pos3.z, pos4.z);

    vec4 posZInv = 1.0 / posZ;

    posX *= posZInv;
    posY *= posZInv;

    posX = posX * 0.5 + 0.5;
    posY = posY * 0.5 + 0.5;

    vec4 screenBoundF = clamp(
        vec4(
            min4(posX), min4(posY),
            max4(posX), max4(posY)
        ), 0.0, 1.0
    );
    screenBoundF *= uval_viewportSize.xyxy;
    uvec4 screenBound = uvec4(floor(screenBoundF.xy), ceil(screenBoundF.zw));

    survived = survived & uint(!any(equal(round(screenBoundF.xy), round(screenBoundF.zw))));

    return bool(survived);
}

void rasterize(uint baseLocalQuadIndex) {
    uint localQuadIndex = baseLocalQuadIndex + gl_LocalInvocationID.x;
    if (localQuadIndex < shared_quadCount) {

        int quadIndexOffset = int(shared_quadIndexOffset[localQuadIndex]);
        uint quadIndex = shared_metaFirstCount.x + uint(quadIndexOffset);

        uint quadPosDataIdx = ssbo_quadPosIndexBuffer[quadIndex] * 6u;

        vec4 posXs = decodePos(readPosData(quadPosDataIdx));
        vec4 posYs = decodePos(readPosData(quadPosDataIdx + 2u));
        vec4 posZs = decodePos(readPosData(quadPosDataIdx + 4u));

        vec3 chunkOffset = shared_chunkOffset;
        posXs = posXs * coordConvert + chunkOffset.x;
        posYs = posYs * coordConvert + chunkOffset.y;
        posZs = posZs * coordConvert + chunkOffset.z;

        vec3 pos1 = (ubo_cameraDefault.combined * vec4(posXs.x, posYs.x, posZs.x, 1.0)).xyw;
        vec3 pos2 = (ubo_cameraDefault.combined * vec4(posXs.y, posYs.y, posZs.y, 1.0)).xyw;
        vec3 pos3 = (ubo_cameraDefault.combined * vec4(posXs.z, posYs.z, posZs.z, 1.0)).xyw;
        vec3 pos4 = (ubo_cameraDefault.combined * vec4(posXs.w, posYs.w, posZs.w, 1.0)).xyw;

        posXs = vec4(pos1.x, pos2.x, pos3.x, pos4.x);
        posYs = vec4(pos1.y, pos2.y, pos3.y, pos4.y);
        posZs = vec4(pos1.z, pos2.z, pos3.z, pos4.z);

        vec4 posZInv = 1.0 / posZs;

        posXs *= posZInv;
        posYs *= posZInv;

        posXs = posXs * 0.5 + 0.5;
        posYs = posYs * 0.5 + 0.5;

        vec4 screenBoundF = clamp(
            vec4(
                min4(posXs), min4(posYs),
                max4(posXs), max4(posYs)
            ), 0.0, 1.0
        );
        screenBoundF *= uval_viewportSize.xyxy;
        ivec4 screenBound = ivec4(floor(screenBoundF.xy), ceil(screenBoundF.zw));
        screenBoundF = vec4(screenBound);
        vec2 texelNF = screenBoundF.zw - screenBoundF.xy;
        vec2 invTexelN = 1.0 / texelNF;
        screenBoundF *= uval_viewportSize.zwzw;

        pos1 = vec3(posXs.x, posYs.x, posZs.x);
        pos2 = vec3(posXs.y, posYs.y, posZs.y);
        pos3 = vec3(posXs.z, posYs.z, posZs.z);
        pos4 = vec3(posXs.w, posYs.w, posZs.w);

        vec3 t1bBase, t1bDx, t1bDy;
        swr_calcBarycentricGrad(screenBoundF, invTexelN, pos1.xy, pos2.xy, pos3.xy, t1bBase, t1bDx, t1bDy);
        t1bBase += (t1bDx + t1bDy) * 0.5;
        t1bDy -= t1bDx * texelNF.x;

        vec3 t2bBase, t2bDx, t2bDy;
        swr_calcBarycentricGrad(screenBoundF, invTexelN, pos3.xy, pos4.xy, pos1.xy, t2bBase, t2bDx, t2bDy);
        t2bBase += (t2bDx + t2bDy) * 0.5;
        t2bDy -= t2bDx * texelNF.x;

        i64vec3 valueVec;
        ivec3 outputCoord;
        vec3 t1b = t1bBase;
        vec3 t2b = t2bBase;

        #ifdef CUTOUT
        uint texCoordIdx = ssbo_quadAttribIndexBuffer[quadIndex] * 4u;

        uvec4 texCoordXY = uvec4(
            ssbo_quadTexCoordDataBuffer[texCoordIdx],
            ssbo_quadTexCoordDataBuffer[texCoordIdx + 1u],
            ssbo_quadTexCoordDataBuffer[texCoordIdx + 2u],
            ssbo_quadTexCoordDataBuffer[texCoordIdx + 3u]
        );
        #endif

        for (outputCoord.y = screenBound.y; outputCoord.y < screenBound.w; outputCoord.y++) {
            for (outputCoord.x = screenBound.x; outputCoord.x < screenBound.z; outputCoord.x++) {
                if (min3(t1b) >= 0.0 || min3(t2b) >= 0.0) {
                    outputCoord.z = outputCoord.y * uval_viewportSizeI.x + outputCoord.x;
                    valueVec.x = ssbo_vBufferDepthQuadIndex[outputCoord.z];
                    valueVec.y = (int64_t(floatBitsToInt(dot(posZs.xyz, t1b))) << 32) | int64_t(-quadIndex);
                    valueVec.z = (int64_t(floatBitsToInt(dot(posZs.zwx, t2b))) << 32) | int64_t(-quadIndex);
                    #ifdef CUTOUT
                    vec4 texCoordX = vec4(
                        unpackUnorm2x16(texCoordXY.x),
                        unpackUnorm2x16(texCoordXY.y)
                    );
                    vec4 texCoordY = vec4(
                        unpackUnorm2x16(texCoordXY.z),
                        unpackUnorm2x16(texCoordXY.w)
                    );
                    vec2 texCoord1 = vec2(dot(texCoordX.xyz, t1b), dot(texCoordY.xyz, t1b));
                    vec2 texCoord2 = vec2(dot(texCoordX.zwx, t2b), dot(texCoordY.zwx, t2b));
                    #endif

                    #ifdef CUTOUT
                    if (min3(t1b) >= 0.0 && texture(usam_blockAlbedoAtlas, texCoord1).a > 0.5 && valueVec.y <= valueVec.x)
                    #else
                    if (min3(t1b) >= 0.0 && valueVec.y <= valueVec.x)
                    #endif
                    {
                        if (atomicMin(ssbo_vBufferDepthQuadIndex[outputCoord.z], valueVec.y) >= valueVec.y) {
                            imageStore(uimg_vBufferTex1, outputCoord.xy, uvec4(vbuffer_encodeBCoord(t1b), 0u, 0u, 0u));
                            #ifdef OVERDRAW_DEBUG
                            imageAtomicAdd(uimg_overdrawCounter, outputCoord.xy, 1u);
                            #endif
                        }
                    }

                    #ifdef CUTOUT
                    if (min3(t2b) >= 0.0 && texture(usam_blockAlbedoAtlas, texCoord2).a > 0.5 && valueVec.z <= valueVec.x)
                    #else
                    if (min3(t2b) >= 0.0 && valueVec.z <= valueVec.x)
                    #endif
                    {
                        if (atomicMin(ssbo_vBufferDepthQuadIndex[outputCoord.z], valueVec.z) >= valueVec.z) {
                            imageStore(uimg_vBufferTex1, outputCoord.xy, uvec4(vbuffer_encodeBCoord(vec3(t2b.z, 0.0, t2b.x)), 0u, 0u, 0u));
                            #ifdef OVERDRAW_DEBUG
                            imageAtomicAdd(uimg_overdrawCounter, outputCoord.xy, 1u);
                            #endif
                        }
                    }
                }
                t1b += t1bDx;
                t2b += t2bDx;
            }
            t1b += t1bDy;
            t2b += t2bDy;
        }
    }
}

void setup(uint baseLocalQuadIndex) {
    uint localQuadIndex = baseLocalQuadIndex + gl_LocalInvocationID.x;
    if (localQuadIndex < shared_metaFirstCount.y) {
        bool survived = cullQuad(localQuadIndex);

        uvec4 ballot = subgroupBallot(survived);
        uint subgroupCount = subgroupBallotBitCount(ballot);

        uint quadWriteBaseIdx;

        if (subgroupElect()) {
            quadWriteBaseIdx = atomicAdd(shared_quadCount, subgroupCount);
        }

        quadWriteBaseIdx = subgroupBroadcastFirst(quadWriteBaseIdx);

        if (survived) {
            quadWriteBaseIdx += subgroupBallotExclusiveBitCount(ballot);
            shared_quadIndexOffset[quadWriteBaseIdx] = uint16_t(localQuadIndex);
        }
    }
}

void init() {
    QuadBatchInfo batchMetadata = ssbo_quadBatchInfoBuffer[gl_WorkGroupID.x];
    shared_metaFirstCount = uvec2(batchMetadata.first, batchMetadata.count);
    vec3 chunkOffset = vec3(uvec3(batchMetadata.offsetEncoded) >> uvec3(0u, 8u, 16u) & uvec3(255u));
    chunkOffset = chunkOffset * 16.0 + uval_originOffset;
    shared_chunkOffset = chunkOffset;
}

void clear() {
    shared_quadCount = 0u;
    uint xd = gl_LocalInvocationID.x << 1u;
    shared_quadIndexOffset[xd] = uint16_t(0);
    shared_quadIndexOffset[xd + 1u] = uint16_t(0);
}

void main() {
    init();
    clear();

    uint setupIter = (shared_metaFirstCount.y + WORKGROUP_SIZE - 1) / WORKGROUP_SIZE;

    for (uint i = 0u; i < setupIter; i++) {
        setup(i * gl_WorkGroupSize.x);
    }

    memoryBarrierShared();
    barrier();

    uint rasterizeIter = (shared_quadCount + WORKGROUP_SIZE - 1) / WORKGROUP_SIZE;

    for (uint i = 0u; i < rasterizeIter; i++) {
        rasterize(i * gl_WorkGroupSize.x);
    }
}
