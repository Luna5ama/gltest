#version 460 core

#if FLAG_TYPE == uint8_t
#extension GL_NV_gpu_shader5 : enable
#elif FLAG_TYPE == uint16_t
#extension GL_AMD_gpu_shader_int16 : enable
#endif

#extension GL_NV_mesh_shader : enable

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

struct BatchInfo {
    uint chunkIndex;
    uint quadStartIndex;
    uint quadCount;
    uint chunkOffsetEncoded;
};

#if CULL_PASS != 0
layout(std430) readonly buffer VisibleBuffer {
    uint lastOffset;
    FLAG_TYPE states[];
} ssbo_visibleBuffer;
#endif

layout(std430) restrict readonly buffer BatchInfoBuffer {
    BatchInfo ssbo_batchInfoBuffer[];
};

uniform vec3 uval_originOffset;

taskNV out Task {
    vec3 chunkOffset;
    uint quadStartIndex;
    uint quadCount;
} dataOut;

const uvec3 CHUNK_OFFSET_BITMASK = (uvec3(1u) << uvec3(13u, 6u, 13u)) - uvec3(1u);
const uvec3 CHUNK_OFFSET_BITSHIFT = uvec3(0u, 13u, 13u + 6u);

void main() {
    uint batchIndex = gl_GlobalInvocationID.x;
    BatchInfo batchInfo = ssbo_batchInfoBuffer[batchIndex];

    uvec3 chunkOffsetEncoded = uvec3(batchInfo.chunkOffsetEncoded);
    chunkOffsetEncoded = (chunkOffsetEncoded >> CHUNK_OFFSET_BITSHIFT) & CHUNK_OFFSET_BITMASK;
    vec3 chunkOffset = vec3(chunkOffsetEncoded);
    chunkOffset = chunkOffset * 16.0 + uval_originOffset;

    #if CULL_PASS == 1
    bool isCameraChunk = dot(chunkOffset, chunkOffset) < 1024.0;
    bool last = bool(ssbo_visibleBuffer.states[batchInfo.chunkIndex + ssbo_visibleBuffer.lastOffset]) || isCameraChunk;
    if (!last) {
        gl_TaskCountNV = 0;
        return;
    }
    #elif CULL_PASS == 2
    bool last = bool(ssbo_visibleBuffer.states[batchInfo.chunkIndex + ssbo_visibleBuffer.lastOffset]);
    bool curr = bool(ssbo_visibleBuffer.states[batchInfo.chunkIndex]);
    if (last || !curr) {
        gl_TaskCountNV = 0;
        return;
    }
    #elif CULL_PASS == 3
    bool isCameraChunk = dot(chunkOffset, chunkOffset) < 1024.0;
    bool curr = bool(ssbo_visibleBuffer.states[batchInfo.chunkIndex]) || isCameraChunk;
    if (!curr) {
        gl_TaskCountNV = 0;
        return;
    }
    #endif

    dataOut.chunkOffset = chunkOffset;
    dataOut.quadStartIndex = batchInfo.quadStartIndex;
    dataOut.quadCount = batchInfo.quadCount;

    gl_TaskCountNV = (dataOut.quadCount + 15) / 16;
}