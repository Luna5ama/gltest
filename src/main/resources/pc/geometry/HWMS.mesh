#version 460 core
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_NV_mesh_shader : enable

#include "../GlobalCamera.glsl"
#include "../utils/SWRUtils.glsl"

layout(local_size_x = 16, local_size_y = 1, local_size_z = 1) in;

layout(max_vertices = 64, max_primitives = 32) out;
layout(triangles) out;

layout(std430) restrict readonly buffer QuadPosDataBuffer {
    uvec2 ssbo_quadPosDataBuffer[];
};

layout(std430) restrict readonly buffer QuadPosIndexBuffer {
    uint ssbo_quadPosIndexBuffer[];
};

uniform vec4 uval_viewportSize;

taskNV in Task {
    uint chunkIndex;
    vec3 chunkOffset;
    uint quadStartIndex;
    uint quadCount;
} dataIn;

layout(location = 0) out VertData {
    flat uint quadIndex;
    flat uint chunkIndex;
    vec4 bCoord;
} vertDataOut[];

const vec4 COORD_CONVERT = vec4(2.51773861295491E-4);

float min4(vec4 v) {
    return min(min(v.x, v.y), min(v.z, v.w));
}

float max4(vec4 v) {
    return max(max(v.x, v.y), max(v.z, v.w));
}

bool writeVertexData() {
    if (gl_GlobalInvocationID.x >= dataIn.quadCount) {
        return false;
    }

    uint quadIndex = dataIn.quadStartIndex + gl_GlobalInvocationID.x;

    uint vertWriteIdxBase = gl_LocalInvocationID.x << 2u;

    uint writeIdx1 = vertWriteIdxBase + 0u;
    uint writeIdx2 = vertWriteIdxBase + 1u;
    uint writeIdx3 = vertWriteIdxBase + 2u;
    uint writeIdx4 = vertWriteIdxBase + 3u;

    vertDataOut[writeIdx1].quadIndex = quadIndex;
    vertDataOut[writeIdx2].quadIndex = quadIndex;
    vertDataOut[writeIdx3].quadIndex = quadIndex;
    vertDataOut[writeIdx4].quadIndex = quadIndex;

    vertDataOut[writeIdx1].chunkIndex = dataIn.chunkIndex;
    vertDataOut[writeIdx2].chunkIndex = dataIn.chunkIndex;
    vertDataOut[writeIdx3].chunkIndex = dataIn.chunkIndex;
    vertDataOut[writeIdx4].chunkIndex = dataIn.chunkIndex;

    uint survived = 1;

    uint quadPosDataIdx = ssbo_quadPosIndexBuffer[quadIndex] * 3u;

    uvec2 posXData = ssbo_quadPosDataBuffer[quadPosDataIdx];
    uvec2 posYData = ssbo_quadPosDataBuffer[quadPosDataIdx + 1u];
    uvec2 posZData = ssbo_quadPosDataBuffer[quadPosDataIdx + 2u];

    vec4 posXs = decodePos(posXData);
    vec4 posYs = decodePos(posYData);
    vec4 posZs = decodePos(posZData);

    posXs = posXs * COORD_CONVERT + dataIn.chunkOffset.x;
    posYs = posYs * COORD_CONVERT + dataIn.chunkOffset.y;
    posZs = posZs * COORD_CONVERT + dataIn.chunkOffset.z;

    vec4 pos1 = ubo_cameraDefault.combined * vec4(posXs.x, posYs.x, posZs.x, 1.0);
    vec4 pos2 = ubo_cameraDefault.combined * vec4(posXs.y, posYs.y, posZs.y, 1.0);
    vec4 pos3 = ubo_cameraDefault.combined * vec4(posXs.z, posYs.z, posZs.z, 1.0);
    vec4 pos4 = ubo_cameraDefault.combined * vec4(posXs.w, posYs.w, posZs.w, 1.0);

    survived = survived & uint(determinant(mat3(pos1.xyw, pos2.xyw, pos3.xyw)) > 0.0);

    posXs = vec4(pos1.x, pos2.x, pos3.x, pos4.x);
    posYs = vec4(pos1.y, pos2.y, pos3.y, pos4.y);
    posZs = vec4(pos1.w, pos2.w, pos3.w, pos4.w);

    vec4 posZInv = 1.0 / posZs;

    posXs *= posZInv;
    posYs *= posZInv;

    posXs = posXs * 0.5 + 0.5;
    posYs = posYs * 0.5 + 0.5;

    vec4 screenBoundF = clamp(
        vec4(
            min4(posXs), min4(posYs),
            max4(posXs), max4(posYs)
        ), 0.0, 1.0
    );
    screenBoundF *= uval_viewportSize.xyxy;
    survived = survived & uint(!any(equal(round(screenBoundF.xy), round(screenBoundF.zw))));

    gl_MeshVerticesNV[writeIdx1].gl_Position = pos1;
    gl_MeshVerticesNV[writeIdx2].gl_Position = pos2;
    gl_MeshVerticesNV[writeIdx3].gl_Position = pos3;
    gl_MeshVerticesNV[writeIdx4].gl_Position = pos4;

    vertDataOut[writeIdx1].bCoord = vec4(1.0, 0.0, 0.0, 0.0);
    vertDataOut[writeIdx2].bCoord = vec4(0.0, 1.0, 0.0, 0.0);
    vertDataOut[writeIdx3].bCoord = vec4(0.0, 0.0, 1.0, 0.0);
    vertDataOut[writeIdx4].bCoord = vec4(0.0, 0.0, 0.0, 1.0);

    return bool(survived);
}

void writeIndices(uint localQuadIndex) {
    uint primIndicesBaseIdx = localQuadIndex * 6;
    uint vertIdxBase = gl_LocalInvocationID.x << 2;

    gl_PrimitiveIndicesNV[primIndicesBaseIdx + 0] = vertIdxBase + 0;
    gl_PrimitiveIndicesNV[primIndicesBaseIdx + 1] = vertIdxBase + 1;
    gl_PrimitiveIndicesNV[primIndicesBaseIdx + 2] = vertIdxBase + 2;

    gl_PrimitiveIndicesNV[primIndicesBaseIdx + 3] = vertIdxBase + 2;
    gl_PrimitiveIndicesNV[primIndicesBaseIdx + 4] = vertIdxBase + 3;
    gl_PrimitiveIndicesNV[primIndicesBaseIdx + 5] = vertIdxBase + 0;

    uint primBaseIdx = localQuadIndex << 1u;

    gl_MeshPrimitivesNV[primBaseIdx + 0u].gl_PrimitiveID = int(primBaseIdx + 0u);
    gl_MeshPrimitivesNV[primBaseIdx + 1u].gl_PrimitiveID = int(primBaseIdx + 1u);
}

void main() {
    bool survived = writeVertexData();
    uvec4 ballot = subgroupBallot(survived);
    uint subgroupCount = subgroupBallotBitCount(ballot);

    if (survived) {
        uint localQuadIndex = subgroupBallotExclusiveBitCount(ballot);
        writeIndices(localQuadIndex);
    }

    if (gl_LocalInvocationID.x == 0) {
        gl_PrimitiveCountNV = subgroupCount * 2;
    }
}