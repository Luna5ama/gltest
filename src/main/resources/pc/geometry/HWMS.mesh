#version 460 core
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_NV_mesh_shader : enable

#include "../GlobalCamera.glsl"

layout(local_size_x = 16, local_size_y = 1, local_size_z = 1) in;

layout(max_vertices = 64, max_primitives = 32) out;
layout(triangles) out;

layout(std430) restrict readonly buffer QuadPosDataBuffer {
    uint ssbo_quadPosDataBuffer[];
};

layout(std430) restrict readonly buffer QuadPosIndexBuffer {
    uint ssbo_quadPosIndexBuffer[];
};

uniform vec4 uval_viewportSize;

vec4 readPos(uint idx) {
    uint data1 = ssbo_quadPosDataBuffer[idx];
    uint data2 = ssbo_quadPosDataBuffer[idx + 1];
    return vec4(uvec4(data1 & 0xFFFFu, data1 >> 16u, data2 & 0xFFFFu, data2 >> 16u));
}

taskNV in Task {
    vec3 chunkOffset;
    uint quadStartIndex;
    uint quadCount;
} dataIn;

layout(location = 0) out VertData {
    flat uint quadIndex;
    vec4 bCoord;
    float depth;
} vertDataOut[];

const vec4 coordConvert = vec4(2.51773861295491E-4);

float min4(vec4 v) {
    return min(min(v.x, v.y), min(v.z, v.w));
}

float max4(vec4 v) {
    return max(max(v.x, v.y), max(v.z, v.w));
}

bool writeVertexData() {
    if (gl_GlobalInvocationID.x >= dataIn.quadCount) {
        return false;
    }

    uint quadIndex = dataIn.quadStartIndex + gl_GlobalInvocationID.x;

    uint vertWriteIdxBase = gl_LocalInvocationID.x << 2u;

    uint writeIdx1 = vertWriteIdxBase + 0u;
    uint writeIdx2 = vertWriteIdxBase + 1u;
    uint writeIdx3 = vertWriteIdxBase + 2u;
    uint writeIdx4 = vertWriteIdxBase + 3u;

    vertDataOut[writeIdx1].quadIndex = quadIndex;
    vertDataOut[writeIdx2].quadIndex = quadIndex;
    vertDataOut[writeIdx3].quadIndex = quadIndex;
    vertDataOut[writeIdx4].quadIndex = quadIndex;

    uint survived = 1;

    uint quadPosDataIdx = ssbo_quadPosIndexBuffer[quadIndex] * 6u;
    vec4 posX = readPos(quadPosDataIdx);
    vec4 posY = readPos(quadPosDataIdx + 2u);
    vec4 posZ = readPos(quadPosDataIdx + 4u);

    posX = posX * coordConvert + dataIn.chunkOffset.x;
    posY = posY * coordConvert + dataIn.chunkOffset.y;
    posZ = posZ * coordConvert + dataIn.chunkOffset.z;

    vec4 pos1 = ubo_cameraDefault.combined * vec4(posX.x, posY.x, posZ.x, 1.0);
    vec4 pos2 = ubo_cameraDefault.combined * vec4(posX.y, posY.y, posZ.y, 1.0);
    vec4 pos3 = ubo_cameraDefault.combined * vec4(posX.z, posY.z, posZ.z, 1.0);
    vec4 pos4 = ubo_cameraDefault.combined * vec4(posX.w, posY.w, posZ.w, 1.0);

    survived = survived & uint(determinant(mat3(pos1.xyw, pos2.xyw, pos3.xyw)) > 0.0);

    posX = vec4(pos1.x, pos2.x, pos3.x, pos4.x);
    posY = vec4(pos1.y, pos2.y, pos3.y, pos4.y);
    posZ = vec4(pos1.w, pos2.w, pos3.w, pos4.w);

    vec4 posZInv = 1.0 / posZ;

    posX *= posZInv;
    posY *= posZInv;

    posX = posX * 0.5 + 0.5;
    posY = posY * 0.5 + 0.5;

    vec4 screenBoundF = clamp(
        vec4(
            min4(posX), min4(posY),
            max4(posX), max4(posY)
        ), 0.0, 1.0
    );
    screenBoundF *= uval_viewportSize.xyxy;
    survived = survived & uint(!any(equal(round(screenBoundF.xy), round(screenBoundF.zw))));

    gl_MeshVerticesNV[writeIdx1].gl_Position = pos1;
    gl_MeshVerticesNV[writeIdx2].gl_Position = pos2;
    gl_MeshVerticesNV[writeIdx3].gl_Position = pos3;
    gl_MeshVerticesNV[writeIdx4].gl_Position = pos4;

    vertDataOut[writeIdx1].bCoord = vec4(1.0, 0.0, 0.0, 0.0);
    vertDataOut[writeIdx2].bCoord = vec4(0.0, 1.0, 0.0, 0.0);
    vertDataOut[writeIdx3].bCoord = vec4(0.0, 0.0, 1.0, 0.0);
    vertDataOut[writeIdx4].bCoord = vec4(0.0, 0.0, 0.0, 1.0);

    vertDataOut[writeIdx1].depth = pos1.w;
    vertDataOut[writeIdx2].depth = pos2.w;
    vertDataOut[writeIdx3].depth = pos3.w;
    vertDataOut[writeIdx4].depth = pos4.w;

    return bool(survived);
}

void writeIndices(uint localQuadIndex) {
    uint primitiveIdxBase = localQuadIndex * 6;
    uint vertIdxBase = gl_LocalInvocationID.x << 2;

    gl_PrimitiveIndicesNV[primitiveIdxBase + 0] = vertIdxBase + 0;
    gl_PrimitiveIndicesNV[primitiveIdxBase + 1] = vertIdxBase + 1;
    gl_PrimitiveIndicesNV[primitiveIdxBase + 2] = vertIdxBase + 2;

    gl_PrimitiveIndicesNV[primitiveIdxBase + 3] = vertIdxBase + 2;
    gl_PrimitiveIndicesNV[primitiveIdxBase + 4] = vertIdxBase + 3;
    gl_PrimitiveIndicesNV[primitiveIdxBase + 5] = vertIdxBase + 0;
}

void main() {
    bool survived = writeVertexData();
    uvec4 ballot = subgroupBallot(survived);
    uint subgroupCount = subgroupBallotBitCount(ballot);

    if (survived) {
        uint localQuadIndex = subgroupBallotExclusiveBitCount(ballot);
        writeIndices(localQuadIndex);
    }

    if (gl_LocalInvocationID.x == 0) {
        gl_PrimitiveCountNV = subgroupCount * 2;
    }
}