#version 460 core

#include "GlobalCamera.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

const float CONVERT = 1.5258789066052713679627681542101e-5;

uniform float uval_mixFactor;
uniform vec3 uval_cameraDelta;

uniform sampler2D usam_inputDepth;
uniform sampler2D usam_prevTexture;
layout(rgba16f) uniform restrict readonly image2D uimg_input;
layout(rgba16f) uniform restrict writeonly image2D uimg_output;

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outputSize = imageSize(uimg_output);
    if (any(greaterThanEqual(texel, outputSize))) {
        return;
    }
    float depth = texelFetch(usam_inputDepth, texel, 0).r;
    if (depth == 0.0) {
        return;
    }

    vec4 currColor = max(imageLoad(uimg_input, texel), vec4(0.0));

    vec3 nearCurr0 = imageLoad(uimg_input, clamp(texel + ivec2(1, 0), ivec2(0), outputSize)).rgb;
    vec3 nearCurr1 = imageLoad(uimg_input, clamp(texel + ivec2(0, 1), ivec2(0), outputSize)).rgb;
    vec3 nearCurr2 = imageLoad(uimg_input, clamp(texel + ivec2(-1, 0), ivec2(0), outputSize)).rgb;
    vec3 nearCurr3 = imageLoad(uimg_input, clamp(texel + ivec2(0, -1), ivec2(0), outputSize)).rgb;
    vec3 nearMin = min(min(nearCurr0, nearCurr1), min(nearCurr2, nearCurr3));
    vec3 nearMax = max(max(nearCurr0, nearCurr1), max(nearCurr2, nearCurr3));

    vec3 screenPos = vec3((vec2(texel) + 0.5) / vec2(outputSize), depth);
    vec3 ndcPos = vec3(screenPos.xy * 2.0 - 1.0, screenPos.z);
    vec4 scenePos = ubo_cameraNoJitter.invCombined * vec4(ndcPos, 1.0);
    scenePos /= scenePos.w;
    vec4 prevScenePos = scenePos;
    prevScenePos.xyz += uval_cameraDelta;
    vec4 prevNdcPos = ubo_prevCameraNoJitter.combined * prevScenePos;
    prevNdcPos.xyz /= prevNdcPos.w;
    vec3 prevScreenPos = vec3(prevNdcPos.xy * 0.5 + 0.5, prevNdcPos.z);

    vec4 prevColor = texture(usam_prevTexture, prevScreenPos.xy);
    prevColor.rgb = clamp(prevColor.rgb, nearMin, nearMax);
    vec4 color = currColor;

    color.rgb = mix(currColor.rgb, prevColor.rgb, uval_mixFactor);
    color.a = 1.0;

    imageStore(uimg_output, texel, color);
}
