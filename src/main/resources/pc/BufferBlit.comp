#version 460 core

#include "GlobalCamera.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

const float CONVERT = 1.5258789066052713679627681542101e-5;

uniform float uval_mixFactor;
uniform vec3 uval_cameraDelta;

uniform sampler2D usam_inputDepth;
uniform sampler2D usam_prevTexture;
layout(rgba16f) uniform restrict readonly image2D uimg_input;
layout(rgba16f) uniform restrict writeonly image2D uimg_output;

void updateAABB(vec3 point, inout vec3 minPoint, inout vec3 maxPoint) {
    minPoint = min(minPoint, point);
    maxPoint = max(maxPoint, point);
}


// from https://github.com/GameTechDev/TAA
vec4 BicubicSampling5(sampler2D samplerV, vec2 inHistoryUV){
    vec2 reso = vec2(textureSize(samplerV, 0));
    vec2 inHistoryST = inHistoryUV * reso;
    const vec2 rcpResolution = 1.0 / reso;


    const vec2 fractional = fract(inHistoryST - 0.5);
    const vec2 uv = (floor(inHistoryST - 0.5) + vec2(0.5f, 0.5f)) * rcpResolution;

    // 5-tap bicubic sampling (for Hermite/Carmull-Rom filter) -- (approximate from original 16->9-tap bilinear fetching)
    const vec2 t = vec2(fractional);
    const vec2 t2 = vec2(fractional * fractional);
    const vec2 t3 = vec2(fractional * fractional * fractional);
    const float s = float(0.5);
    const vec2 w0 = -s * t3 + float(2.f) * s * t2 - s * t;
    const vec2 w1 = (float(2.f) - s) * t3 + (s - float(3.f)) * t2 + float(1.f);
    const vec2 w2 = (s - float(2.f)) * t3 + (3 - float(2.f) * s) * t2 + s * t;
    const vec2 w3 = s * t3 - s * t2;
    const vec2 s0 = w1 + w2;
    const vec2 f0 = w2 / (w1 + w2);
    const vec2 m0 = uv + f0 * rcpResolution;
    const vec2 tc0 = uv - 1.f * rcpResolution;
    const vec2 tc3 = uv + 2.f * rcpResolution;

    const vec4 A = vec4(texture(samplerV, vec2(m0.x, tc0.y)));
    const vec4 B = vec4(texture(samplerV, vec2(tc0.x, m0.y)));
    const vec4 C = vec4(texture(samplerV, vec2(m0.x, m0.y)));
    const vec4 D = vec4(texture(samplerV, vec2(tc3.x, m0.y)));
    const vec4 E = vec4(texture(samplerV, vec2(m0.x, tc3.y)));
    const vec4 color = (float(0.5f) * (A + B) * w0.x + A * s0.x + float(0.5f) * (A + B) * w3.x) * w0.y + (B * w0.x + C * s0.x + D * w3.x) * s0.y + (float(0.5f) * (B + E) * w0.x + E * s0.x + float(0.5f) * (D + E) * w3.x) * w3.y;
    return color;
}

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outputSize = imageSize(uimg_output);
    if (any(greaterThanEqual(texel, outputSize))) {
        return;
    }
    float depth = texelFetch(usam_inputDepth, texel, 0).r;
    if (depth == 0.0) {
        return;
    }

    vec4 currColor = max(imageLoad(uimg_input, texel), vec4(0.0));

    vec3 nearMin = currColor.xyz;
    vec3 nearMax = currColor.xyz;

    updateAABB(imageLoad(uimg_input, clamp(texel + ivec2(1, 0), ivec2(0), outputSize)).rgb, nearMin, nearMax);
    updateAABB(imageLoad(uimg_input, clamp(texel + ivec2(0, 1), ivec2(0), outputSize)).rgb, nearMin, nearMax);
    updateAABB(imageLoad(uimg_input, clamp(texel + ivec2(-1, 0), ivec2(0), outputSize)).rgb, nearMin, nearMax);
    updateAABB(imageLoad(uimg_input, clamp(texel + ivec2(0, -1), ivec2(0), outputSize)).rgb, nearMin, nearMax);
    updateAABB(imageLoad(uimg_input, clamp(texel + ivec2(1, 1), ivec2(0), outputSize)).rgb, nearMin, nearMax);
    updateAABB(imageLoad(uimg_input, clamp(texel + ivec2(-1, 1), ivec2(0), outputSize)).rgb, nearMin, nearMax);
    updateAABB(imageLoad(uimg_input, clamp(texel + ivec2(1, -1), ivec2(0), outputSize)).rgb, nearMin, nearMax);
    updateAABB(imageLoad(uimg_input, clamp(texel + ivec2(-1, -1), ivec2(0), outputSize)).rgb, nearMin, nearMax);

//    vec3 nearCurr0 = imageLoad(uimg_input, clamp(texel + ivec2(1, 0), ivec2(0), outputSize)).rgb;
//    vec3 nearCurr1 = imageLoad(uimg_input, clamp(texel + ivec2(0, 1), ivec2(0), outputSize)).rgb;
//    vec3 nearCurr2 = imageLoad(uimg_input, clamp(texel + ivec2(-1, 0), ivec2(0), outputSize)).rgb;
//    vec3 nearCurr3 = imageLoad(uimg_input, clamp(texel + ivec2(0, -1), ivec2(0), outputSize)).rgb;
//    vec3 nearMin = min(min(nearCurr0, nearCurr1), min(nearCurr2, nearCurr3));
//    vec3 nearMax = max(max(nearCurr0, nearCurr1), max(nearCurr2, nearCurr3));

    vec3 screenPos = vec3((vec2(texel) + 0.5) / vec2(outputSize), depth);
    vec3 ndcPos = vec3(screenPos.xy * 2.0 - 1.0, screenPos.z);
    vec4 scenePos = ubo_camera.invCombinedNoJitter * vec4(ndcPos, 1.0);
    scenePos /= scenePos.w;
    vec4 prevScenePos = scenePos;
    prevScenePos.xyz += uval_cameraDelta;
    vec4 prevNdcPos = ubo_camera.prevCombinedNoJitter * prevScenePos;
    prevNdcPos.xyz /= prevNdcPos.w;
    vec3 prevScreenPos = vec3(prevNdcPos.xy * 0.5 + 0.5, prevNdcPos.z);

    vec4 prevColor = BicubicSampling5(usam_prevTexture, prevScreenPos.xy);
    prevColor.rgb = clamp(prevColor.rgb, nearMin, nearMax);
    vec4 color = currColor;

    color.rgb = currColor.rgb;
    color.a = 1.0;

    imageStore(uimg_output, texel, color);
}
