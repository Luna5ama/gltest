float min3(vec3 v) {
    return min(v.x, min(v.y, v.z));
}

float min4(vec4 v) {
    return min(min(v.x, v.y), min(v.z, v.w));
}

void main() {
    QuadBatchInfo batchMetadata = ssbo_quadBatchInfoBuffer[gl_WorkGroupID.x];
    uint metaEncoded = batchMetadata.encoded_count_offsets;
    uint metaFirst = batchMetadata.first;
    uint metaCount = metaEncoded & 0xFFu;
    vec3 chunkOffset = vec3(uvec3(metaEncoded) >> uvec3(8u, 16u, 24u) & uvec3(255u));
    chunkOffset = chunkOffset * 16.0 + uval_originOffset;

    if (gl_LocalInvocationID.x >= metaCount) return;

    uint quadIndex = metaFirst + gl_LocalInvocationID.x;

    uint quadPosDataIdx = ssbo_quadPosIndexBuffer[quadIndex] * 6u;

    vec4 posX = readPos(quadPosDataIdx);
    vec4 posY = readPos(quadPosDataIdx + 2u);
    vec4 posZ = readPos(quadPosDataIdx + 4u);

    vec3 pos1 = (ubo_cameraDefault.combined * vec4(vec3(posX.x, posY.x, posZ.x) * coordConvert + chunkOffset, 1.0)).xyw;
    vec3 pos2 = (ubo_cameraDefault.combined * vec4(vec3(posX.y, posY.y, posZ.y) * coordConvert + chunkOffset, 1.0)).xyw;
    vec3 pos3 = (ubo_cameraDefault.combined * vec4(vec3(posX.z, posY.z, posZ.z) * coordConvert + chunkOffset, 1.0)).xyw;
    vec3 pos4 = (ubo_cameraDefault.combined * vec4(vec3(posX.w, posY.w, posZ.w) * coordConvert + chunkOffset, 1.0)).xyw;

    vec4 pos12 = vec4(pos1.xy, pos2.xy);
    vec4 pos34 = vec4(pos3.xy, pos4.xy);

    vec4 posZInv = 1.0 / vec4(pos1.z, pos2.z, pos3.z, pos4.z);

    pos12 = pos12 * posZInv.xxyy;
    pos34 = pos34 * posZInv.zzww;

    if (any(lessThanEqual(vec4(pos1.z, pos2.z, pos3.z, pos4.z), vec4(0.0)))) return;

    if (determinant(mat2(pos34.xy - pos12.xy, pos12.zw - pos12.xy)) >= 0.0) {
        return;
    }

    pos12 = pos12 * 0.5 + 0.5;
    pos34 = pos34 * 0.5 + 0.5;

    pos1 = vec3(pos12.xy, pos1.z);
    pos2 = vec3(pos12.zw, pos2.z);
    pos3 = vec3(pos34.xy, pos3.z);
    pos4 = vec3(pos34.zw, pos4.z);

    bvec4 clipping1 = greaterThanEqual(abs(vec4(pos1.xy, pos2.xy)), vec4(1.0));
    bvec4 clipping2 = greaterThanEqual(abs(vec4(pos3.xy, pos4.xy)), vec4(1.0));

    if (all(bvec2(all(clipping1), all(clipping2)))) return;


    vec2 minScreen = clamp(min(min(pos1.xy, pos2.xy), min(pos3.xy, pos4.xy)), 0.0, 1.0);
    vec2 maxScreen = clamp(max(max(pos1.xy, pos2.xy), max(pos3.xy, pos4.xy)), 0.0, 1.0);
    ivec2 minTexel = ivec2(floor(minScreen * uval_viewportSize.xy));
    ivec2 maxTexel = ivec2(ceil(maxScreen * uval_viewportSize.xy));

    minScreen = vec2(minTexel) * uval_viewportSize.zw;
    maxScreen = vec2(maxTexel) * uval_viewportSize.zw;

    ivec2 texelN = maxTexel - minTexel;
    vec2 invTexelN = 1.0 / vec2(texelN);

    vec3 t1bBase, t1bMx, t1bMy, t1bDx, t1bDy;
    swr_calcBarycentricGrad(minScreen, maxScreen, invTexelN, pos1.xy, pos2.xy, pos3.xy, t1bBase, t1bMx, t1bMy, t1bDx, t1bDy);

    vec3 t2bBase, t2bMx, t2bMy, t2bDx, t2bDy;
    swr_calcBarycentricGrad(minScreen, maxScreen, invTexelN, pos3.xy, pos4.xy, pos1.xy, t2bBase, t2bMx, t2bMy, t2bDx, t2bDy);

    vec2 tDepthBase;
    vec4 tDepthDxDy;
    swr_calcAttribGrad(invTexelN, t1bBase, t1bMx, t1bMy, vec3(pos1.z, pos2.z, pos3.z), tDepthBase.x, tDepthDxDy.x, tDepthDxDy.z);
    swr_calcAttribGrad(invTexelN, t2bBase, t2bMx, t2bMy, vec3(pos3.z, pos4.z, pos1.z), tDepthBase.y, tDepthDxDy.y, tDepthDxDy.w);

    #ifdef CUTOUT
    uint texCoordIdx = ssbo_quadAttribIndexBuffer[quadIndex] * 4u;

    vec4 texCoordX = vec4(
        unpackUnorm2x16(ssbo_quadTexCoordDataBuffer[texCoordIdx]),
        unpackUnorm2x16(ssbo_quadTexCoordDataBuffer[texCoordIdx + 1u])
    );
    vec4 texCoordY = vec4(
        unpackUnorm2x16(ssbo_quadTexCoordDataBuffer[texCoordIdx + 2u]),
        unpackUnorm2x16(ssbo_quadTexCoordDataBuffer[texCoordIdx + 3u])
    );

    vec3 t1TexCoordX = texCoordX.xyz;
    vec3 t1TexCoordY = texCoordY.xyz;
    vec3 t2TexCoordX = texCoordX.zwx;
    vec3 t2TexCoordY = texCoordY.zwx;
    vec4 tTexCoordBase = vec4(dot(t1TexCoordX, t1bBase), dot(t1TexCoordY, t1bBase), dot(t2TexCoordX, t2bBase), dot(t2TexCoordY, t2bBase));
    vec4 tTexCoordMx = vec4(dot(t1TexCoordX, t1bMx), dot(t1TexCoordY, t1bMx), dot(t2TexCoordX, t2bMx), dot(t2TexCoordY, t2bMx));
    vec4 tTexCoordMy = vec4(dot(t1TexCoordX, t1bMy), dot(t1TexCoordY, t1bMy), dot(t2TexCoordX, t2bMy), dot(t2TexCoordY, t2bMy));

    vec4 tTexCoordDx = (tTexCoordMx - tTexCoordBase) * invTexelN.xxxx;
    vec4 tTexCoordDy = (tTexCoordMy - tTexCoordBase) * invTexelN.yyyy;
    vec4 tTexCoordYStart = tTexCoordBase;

    vec4 tTexCoord;
    #endif

    vec3 t1bYStart = t1bBase;
    vec3 t2bYStart = t2bBase;
    vec2 tDepthYStart = tDepthBase;

    ivec2 outputCoord = minTexel;

    uint depth;
    uint minDepth;
    vec4 bCoord4;

    vec3 t1b;
    vec3 t2b;
    vec2 tDepth;

    for (int y = 0; y < texelN.y; y++) {
        t1b = t1bYStart;
        t2b = t2bYStart;
        tDepth = tDepthYStart;
        #ifdef CUTOUT
        tTexCoord = tTexCoordYStart;
        #endif

        for (int x = 0; x < texelN.x; x++) {
            if (min3(t1b) >= 0.0) {
                #ifdef CUTOUT
                if (textureLod(usam_blockAlbedoAtlas, tTexCoord.zw, 0.0).a > 0.5) {
                    #endif
                    uint writeIdx = outputCoord.y * uval_viewportSizeUI.x + outputCoord.x;
                    int64_t writeValue = (int64_t(floatBitsToInt(tDepth.x)) << 32) | int64_t(quadIndex);
                    if (writeValue <= ssbo_vBufferRender[writeIdx]) {
                        int64_t minValue = atomicMin(ssbo_vBufferRender[writeIdx], writeValue);
                        if (minValue >= writeValue) {
                            bCoord4 = vec4(t1b, 0.0);
                            imageStore(uimg_vbufferRender, outputCoord, uvec4(vbuffer_encodeBCoord(bCoord4), 0u, 0u, 0u));
                            #ifdef OVERDRAW_DEBUG
                            imageAtomicAdd(uimg_overdrawCounter, outputCoord, 1u);
                            #endif
                        }
                    }
                    #ifdef CUTOUT
                }
                #endif
            }
            if (min3(t2b) >= 0.0) {
                #ifdef CUTOUT
                if (textureLod(usam_blockAlbedoAtlas, tTexCoord.zw, 0.0).a > 0.5) {
                    #endif
                    uint writeIdx = outputCoord.y * uval_viewportSizeUI.x + outputCoord.x;
                    int64_t writeValue = (int64_t(floatBitsToInt(tDepth.y)) << 32) | int64_t(quadIndex);
                    if (writeValue <= ssbo_vBufferRender[writeIdx]) {
                        int64_t minValue = atomicMin(ssbo_vBufferRender[writeIdx], writeValue);
                        if (minValue >= writeValue) {
                            bCoord4 = vec4(t2b.z, 0.0, t2b.x, t2b.y);
                            imageStore(uimg_vbufferRender, outputCoord, uvec4(vbuffer_encodeBCoord(bCoord4), 0u, 0u, 0u));
                            #ifdef OVERDRAW_DEBUG
                            imageAtomicAdd(uimg_overdrawCounter, outputCoord, 1u);
                            #endif
                        }
                    }
                    #ifdef CUTOUT
                }
                #endif
            }
            t1b += t1bDx;
            t2b += t2bDx;
            tDepth += tDepthDxDy.xy;
            outputCoord.x++;
            #ifdef CUTOUT
            tTexCoord += tTexCoordDx;
            #endif
        }

        t1bYStart += t1bDy;
        t2bYStart += t2bDy;
        tDepthYStart += tDepthDxDy.zw;
        outputCoord = ivec2(minTexel.x, outputCoord.y + 1);
        #ifdef CUTOUT
        tTexCoordYStart += tTexCoordDy;
        #endif
    }
}
