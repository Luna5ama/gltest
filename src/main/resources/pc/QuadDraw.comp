vec3 barycentric(vec2 pa, vec4 v, vec3 d) {
    float d20p = dot(pa, v.xy);
    float d21p = dot(pa, v.zw);

    float denom = d.x * d.z - d.y * d.y;
    vec3 uvw;
    uvw.y = (d.z * d20p - d.y * d21p) / denom;
    uvw.z = (d.x * d21p - d.y * d20p) / denom;
    uvw.x = 1.0f - uvw.y - uvw.z;
    return uvw;
}

void calcVD(vec2 a, vec2 b, vec2 c, out vec4 v, out vec3 d) {
    v = vec4(b, c) - vec4(a, a);
    d = vec3(
        dot(v.xy, v.xy),
        dot(v.xy, v.zw),
        dot(v.zw, v.zw)
    );
}

float min3(vec3 v) {
    return min(v.x, min(v.y, v.z));
}

float min4(vec4 v) {
    return min(min(v.x, v.y), min(v.z, v.w));
}

void main() {
    QuadBatchInfo batchMetadata = ssbo_quadBatchInfoBuffer[gl_WorkGroupID.x];
    uint metaEncoded = batchMetadata.encoded_count_offsets;
    uint metaFirst = batchMetadata.first;
    uint metaCount = metaEncoded & 0xFFu;
    vec3 chunkOffset = vec3(uvec3(metaEncoded) >> uvec3(8u, 16u, 24u) & uvec3(255u));
    chunkOffset = chunkOffset * 16.0 + uval_originOffset;

    if (gl_LocalInvocationID.x >= metaCount) return;

    uint quadIndex = metaFirst + gl_LocalInvocationID.x;

    uint quadPosDataIdx = ssbo_quadPosIndexBuffer[quadIndex] * 6u;

    vec4 posX = readPos(quadPosDataIdx);
    vec4 posY = readPos(quadPosDataIdx + 2u);
    vec4 posZ = readPos(quadPosDataIdx + 4u);

    vec3 pos1 = (ubo_cameraDefault.combined * vec4(vec3(posX.x, posY.x, posZ.x) * coordConvert + chunkOffset, 1.0)).xyw;
    vec3 pos2 = (ubo_cameraDefault.combined * vec4(vec3(posX.y, posY.y, posZ.y) * coordConvert + chunkOffset, 1.0)).xyw;
    vec3 pos3 = (ubo_cameraDefault.combined * vec4(vec3(posX.z, posY.z, posZ.z) * coordConvert + chunkOffset, 1.0)).xyw;
    vec3 pos4 = (ubo_cameraDefault.combined * vec4(vec3(posX.w, posY.w, posZ.w) * coordConvert + chunkOffset, 1.0)).xyw;

    if (any(lessThanEqual(vec4(pos1.z, pos2.z, pos3.z, pos4.z), vec4(0.0)))) return;

    pos1.xy /= pos1.z;
    pos2.xy /= pos2.z;
    pos3.xy /= pos3.z;
    pos4.xy /= pos4.z;

    pos1.xy = pos1.xy * 0.5 + 0.5;
    pos2.xy = pos2.xy * 0.5 + 0.5;
    pos3.xy = pos3.xy * 0.5 + 0.5;
    pos4.xy = pos4.xy * 0.5 + 0.5;

    if (determinant(mat2(pos3.xy - pos1.xy, pos2.xy - pos1.xy)) >= 0.0) {
        return;
    }

    bvec4 clipping1 = greaterThanEqual(abs(vec4(pos1.xy, pos2.xy)), vec4(1.0));
    bvec4 clipping2 = greaterThanEqual(abs(vec4(pos3.xy, pos4.xy)), vec4(1.0));

    if (all(bvec2(all(clipping1), all(clipping2)))) return;

    vec2 minPos = clamp(min(min(pos1.xy, pos2.xy), min(pos3.xy, pos4.xy)), 0.0, 1.0);
    vec2 maxPos = clamp(max(max(pos1.xy, pos2.xy), max(pos3.xy, pos4.xy)), 0.0, 1.0);
    ivec2 minPixelPos = ivec2(floor(minPos * uval_viewportSize.xy));
    ivec2 maxPixelPos = ivec2(ceil(maxPos * uval_viewportSize.xy));

    minPos = vec2(minPixelPos) * uval_viewportSize.zw;
    maxPos = vec2(maxPixelPos) * uval_viewportSize.zw;

    vec3 t1pa = pos1;
    vec3 t1pb = pos2;
    vec3 t1pc = pos3;
    vec4 t1v;
    vec3 t1d;

    vec3 t2pa = pos3;
    vec3 t2pb = pos4;
    vec3 t2pc = pos1;
    vec4 t2bv;
    vec3 t2bd;

    calcVD(t1pa.xy, t1pb.xy, t1pc.xy, t1v, t1d);
    calcVD(t2pa.xy, t2pb.xy, t2pc.xy, t2bv, t2bd);

    vec3 t1bBase = barycentric(minPos - t1pa.xy, t1v, t1d);
    vec3 t2bBase = barycentric(minPos - t2pa.xy, t2bv, t2bd);
    vec3 t1bMx = barycentric(vec2(maxPos.x, minPos.y) - t1pa.xy, t1v, t1d);
    vec3 t2bMx = barycentric(vec2(maxPos.x, minPos.y) - t2pa.xy, t2bv, t2bd);
    vec3 t1bMy = barycentric(vec2(minPos.x, maxPos.y) - t1pa.xy, t1v, t1d);
    vec3 t2bMy = barycentric(vec2(minPos.x, maxPos.y) - t2pa.xy, t2bv, t2bd);

    int xn = maxPixelPos.x - minPixelPos.x;
    int yn = maxPixelPos.y - minPixelPos.y;
    float nx = 1.0 / float(xn);
    float ny = 1.0 / float(yn);

    vec3 b1Dx = (t1bMx - t1bBase) * nx;
    vec3 b1Dy = (t1bMy - t1bBase) * ny;

    vec3 b2Dx = (t2bMx - t2bBase) * nx;
    vec3 b2Dy = (t2bMy - t2bBase) * ny;

    vec2 tDepthBase = vec2(dot(vec3(t1pa.z, t1pb.z, t1pc.z), t1bBase), dot(vec3(t2pa.z, t2pb.z, t2pc.z), t2bBase));
    vec2 tDepthMx = vec2(dot(vec3(t1pa.z, t1pb.z, t1pc.z), t1bMx), dot(vec3(t2pa.z, t2pb.z, t2pc.z), t2bMx));
    vec2 tDepthMy = vec2(dot(vec3(t1pa.z, t1pb.z, t1pc.z), t1bMy), dot(vec3(t2pa.z, t2pb.z, t2pc.z), t2bMy));

    vec2 tDepthDx = (tDepthMx - tDepthBase) * nx;
    vec2 tDepthDy = (tDepthMy - tDepthBase) * nx;

    vec3 t1bYStart = t1bBase;
    vec3 t2bYStart = t2bBase;

    vec2 tDepthYStart = tDepthBase;

    ivec2 outputCoord = minPixelPos;

    uint depth;
    uint minDepth;
    vec4 bCoord4;

    vec3 t1b;
    vec3 t2b;
    vec2 tDepth;

    for (int y = 0; y < yn; y++) {
        t1b = t1bYStart;
        t2b = t2bYStart;
        tDepth = tDepthYStart;

        for (int x = 0; x < xn; x++) {
            if (min3(t1b) >= 0.0) {
                depth = floatBitsToUint(tDepth.x);
                if (depth < imageLoad(uimg_depthRenderTex, outputCoord).x) {
                    minDepth = imageAtomicMin(uimg_depthRenderTex, outputCoord, depth);
                    if (minDepth > depth) {
                        bCoord4 = vec4(t1b, 0.0);
                        imageStore(uimg_vbufferRender, outputCoord, uvec4(quadIndex, vbuffer_encodeBCoord(bCoord4), 0u, 0u));
                        #ifdef OVERDRAW_DEBUG
                        imageAtomicAdd(uimg_overdrawCounter, outputCoord, 1u);
                        #endif
                    }
                }
            }
            if (min3(t2b) >= 0.0) {
                depth = floatBitsToUint(tDepth.y);
                if (depth < imageLoad(uimg_depthRenderTex, outputCoord).x) {
                    minDepth = imageAtomicMin(uimg_depthRenderTex, outputCoord, depth);
                    if (minDepth > depth) {
                        bCoord4 = vec4(t2b.z, 0.0, t2b.x, t2b.y);
                        imageStore(uimg_vbufferRender, outputCoord, uvec4(quadIndex, vbuffer_encodeBCoord(bCoord4), 0u, 0u));
                        #ifdef OVERDRAW_DEBUG
                        imageAtomicAdd(uimg_overdrawCounter, outputCoord, 1u);
                        #endif
                    }
                }
            }
            t1b += b1Dx;
            t2b += b2Dx;
            tDepth += tDepthDx;
            outputCoord.x++;
        }

        t1bYStart += b1Dy;
        t2bYStart += b2Dy;
        tDepthYStart += tDepthDy;
        outputCoord = ivec2(minPixelPos.x, outputCoord.y + 1);
    }
}
