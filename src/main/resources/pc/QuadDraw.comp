float min3(vec3 v) {
    return min(v.x, min(v.y, v.z));
}

float min4(vec4 v) {
    return min(min(v.x, v.y), min(v.z, v.w));
}

shared vec4 posZsShared[BATCH_SIZE];
shared vec4 tDy1Shared[BATCH_SIZE];

void main() {
    QuadBatchInfo batchMetadata = ssbo_quadBatchInfoBuffer[gl_WorkGroupID.x];
    uint metaEncoded = batchMetadata.encoded_count_offsets;
    uint metaFirst = batchMetadata.first;
    uint metaCount = metaEncoded & 0xFFu;
    vec3 chunkOffset = vec3(uvec3(metaEncoded) >> uvec3(8u, 16u, 24u) & uvec3(255u));
    chunkOffset = chunkOffset * 16.0 + uval_originOffset;

    if (gl_LocalInvocationID.x >= metaCount) return;

    uint quadIndex = metaFirst + gl_LocalInvocationID.x;

    uint quadPosDataIdx = ssbo_quadPosIndexBuffer[quadIndex] * 6u;

    vec4 posX = readPos(quadPosDataIdx);
    vec4 posY = readPos(quadPosDataIdx + 2u);
    vec4 posZ = readPos(quadPosDataIdx + 4u);

    vec3 pos1 = (ubo_cameraDefault.combined * vec4(vec3(posX.x, posY.x, posZ.x) * coordConvert + chunkOffset, 1.0)).xyw;
    vec3 pos2 = (ubo_cameraDefault.combined * vec4(vec3(posX.y, posY.y, posZ.y) * coordConvert + chunkOffset, 1.0)).xyw;
    vec3 pos3 = (ubo_cameraDefault.combined * vec4(vec3(posX.z, posY.z, posZ.z) * coordConvert + chunkOffset, 1.0)).xyw;
    vec3 pos4 = (ubo_cameraDefault.combined * vec4(vec3(posX.w, posY.w, posZ.w) * coordConvert + chunkOffset, 1.0)).xyw;

    vec4 pos12 = vec4(pos1.xy, pos2.xy);
    vec4 pos34 = vec4(pos3.xy, pos4.xy);

    vec4 posZInv = 1.0 / vec4(pos1.z, pos2.z, pos3.z, pos4.z);
    //    vec4 posZInv = fastRcpNR2(vec4(pos1.z, pos2.z, pos3.z, pos4.z));

    pos12 = pos12 * posZInv.xxyy;
    pos34 = pos34 * posZInv.zzww;

    if (any(lessThanEqual(vec4(pos1.z, pos2.z, pos3.z, pos4.z), vec4(0.0)))) return;

    if (determinant(mat2(pos34.xy - pos12.xy, pos12.zw - pos12.xy)) >= 0.0) {
        return;
    }

    pos12 = pos12 * 0.5 + 0.5;
    pos34 = pos34 * 0.5 + 0.5;

    pos1 = vec3(pos12.xy, pos1.z);
    pos2 = vec3(pos12.zw, pos2.z);
    pos3 = vec3(pos34.xy, pos3.z);
    pos4 = vec3(pos34.zw, pos4.z);

    bvec4 clipping1 = greaterThanEqual(abs(vec4(pos1.xy, pos2.xy)), vec4(1.0));
    bvec4 clipping2 = greaterThanEqual(abs(vec4(pos3.xy, pos4.xy)), vec4(1.0));

    if (all(bvec2(all(clipping1), all(clipping2)))) return;

    vec4 screenBound = clamp(vec4(min(min(pos1.xy, pos2.xy), min(pos3.xy, pos4.xy)), max(max(pos1.xy, pos2.xy), max(pos3.xy, pos4.xy))), 0.0, 1.0);
    screenBound *= uval_viewportSize.xyxy;
    vec4 boundRounded = vec4(floor(screenBound.xy), ceil(screenBound.zw));
    screenBound = boundRounded * uval_viewportSize.zwzw;

    vec2 texelNF = boundRounded.zw - boundRounded.xy;
    vec2 invTexelN = 1.0 / texelNF;
    ivec4 boundRoundedInt = ivec4(boundRounded);

    vec3 t1bBase, t1bMx, t1bMy, t1bDx, t1bDy;
    swr_calcBarycentricGrad(screenBound, invTexelN, pos1.xy, pos2.xy, pos3.xy, t1bBase, t1bMx, t1bMy, t1bDx, t1bDy);
    t1bDy -= t1bDx * texelNF.x;

    vec3 t2bBase, t2bMx, t2bMy, t2bDx, t2bDy;
    swr_calcBarycentricGrad(screenBound, invTexelN, pos3.xy, pos4.xy, pos1.xy, t2bBase, t2bMx, t2bMy, t2bDx, t2bDy);
    t2bDy -= t2bDx * texelNF.x;
    tDy1Shared[gl_LocalInvocationID.x] = vec4(t1bDy, t2bDy.x);
    vec2 tDy2 = t2bDy.yz;
    posZsShared[gl_LocalInvocationID.x] = vec4(pos1.z, pos2.z, pos3.z, pos4.z);

    #ifdef CUTOUT
    uint texCoordIdx = ssbo_quadAttribIndexBuffer[quadIndex] * 4u;

    uvec4 texCoordXY = uvec4(
        ssbo_quadTexCoordDataBuffer[texCoordIdx],
        ssbo_quadTexCoordDataBuffer[texCoordIdx + 1u],
        ssbo_quadTexCoordDataBuffer[texCoordIdx + 2u],
        ssbo_quadTexCoordDataBuffer[texCoordIdx + 3u]
    );
    #endif

    i64vec4 valueVec;
    ivec4 outputCoord;
    vec3 t1b = t1bBase;
    vec3 t2b = t2bBase;

    for (outputCoord.y = boundRoundedInt.y; outputCoord.y < boundRoundedInt.w; outputCoord.y++) {
        for (outputCoord.x = boundRoundedInt.x; outputCoord.x < boundRoundedInt.z; outputCoord.x++) {
            if (min3(t1b) >= 0.0 || min3(t2b) >= 0.0) {
                outputCoord.z = outputCoord.y * uval_viewportSizeI.x + outputCoord.x;
                valueVec.x = ssbo_vBufferRender[outputCoord.z];
                vec4 posZs = posZsShared[gl_LocalInvocationID.x];
                valueVec.y = (int64_t(floatBitsToInt(dot(posZs.xyz, t1b))) << 32) | int64_t(quadIndex);
                valueVec.z = (int64_t(floatBitsToInt(dot(posZs.zwx, t2b))) << 32) | int64_t(quadIndex);
                vec4 texCoordX = vec4(
                    unpackUnorm2x16(texCoordXY.x),
                    unpackUnorm2x16(texCoordXY.y)
                );
                vec4 texCoordY = vec4(
                    unpackUnorm2x16(texCoordXY.z),
                    unpackUnorm2x16(texCoordXY.w)
                );
                outputCoord.w = int(bool(textureLod(usam_blockAlbedoAtlas, vec2(dot(texCoordX.xyz, t1b), dot(texCoordY.xyz, t1b)), 0.0).a > 0.5)) | (int(bool(textureLod(usam_blockAlbedoAtlas, vec2(dot(texCoordX.zwx, t2b), dot(texCoordY.zwx, t2b)), 0.0).a > 0.5)) << 1);

                if (min3(t1b) >= 0.0) {
                    #ifdef CUTOUT
                    if ((outputCoord.w & 1) == 1) {
                        #endif
                        if (valueVec.y <= valueVec.x) {
                            valueVec.w = atomicMin(ssbo_vBufferRender[outputCoord.z], valueVec.y);
                            if (valueVec.w >= valueVec.y) {
                                imageStore(uimg_vbufferRender, outputCoord.xy, uvec4(vbuffer_encodeBCoord(t1b), 0u, 0u, 0u));
                                #ifdef OVERDRAW_DEBUG
                                imageAtomicAdd(uimg_overdrawCounter, outputCoord.xy, 1u);
                                #endif
                            }
                        }
                        #ifdef CUTOUT
                    }
                    #endif
                }
                if (min3(t2b) >= 0.0) {
                    #ifdef CUTOUT
                    if ((outputCoord.w & 2) == 2) {
                        #endif
                        if (valueVec.z <= valueVec.x) {
                            valueVec.w = atomicMin(ssbo_vBufferRender[outputCoord.z], valueVec.z);
                            if (valueVec.w >= valueVec.z) {
                                imageStore(uimg_vbufferRender, outputCoord.xy, uvec4(vbuffer_encodeBCoord(vec3(t2b.z, 0.0, t2b.x)), 0u, 0u, 0u));
                                #ifdef OVERDRAW_DEBUG
                                imageAtomicAdd(uimg_overdrawCounter, outputCoord.xy, 1u);
                                #endif
                            }
                        }
                        #ifdef CUTOUT
                    }
                    #endif
                }
            }
            t1b += t1bDx;
            t2b += t2bDx;
        }
        t1b += tDy1Shared[gl_LocalInvocationID.x].xyz;
        t2b += vec3(tDy1Shared[gl_LocalInvocationID.x].w, tDy2);
    }
}
