#version 460 core
#extension GL_ARB_gpu_shader_int64 : enable
#extension GL_NV_shader_atomic_int64 : enable
#define CUTOUT

#include "vbuffer/VBuffers.glsl"
#include "GlobalCamera.glsl"
#include "SWRUtils.glsl"
#include "FastMath.glsl"

layout(local_size_x = BATCH_SIZE, local_size_y = 1, local_size_z = 1) in;

uniform vec3 uval_originOffset;
uniform vec4 uval_viewportSize;
uniform ivec2 uval_viewportSizeI;

#ifdef CUTOUT
uniform sampler2D usam_blockAlbedoAtlas;

layout(std430) readonly buffer QuadTexCoordDataBuffer {
    uint ssbo_quadTexCoordDataBuffer[];
};

layout(std430) readonly buffer QuadAttribIndexBuffer {
    uint ssbo_quadAttribIndexBuffer[];
};
#endif

layout(std430) buffer VBufferRender {
    int64_t ssbo_vBufferRender[];
};

layout(r32ui) uniform writeonly uimage2D uimg_vbufferRender;
#ifdef OVERDRAW_DEBUG
layout(r32ui) uniform writeonly uimage2D uimg_overdrawCounter;
#endif

struct QuadBatchInfo {
    uint first;
    uint encoded_count_offsets;
};

layout(std430) restrict readonly buffer QuadBatchInfoBuffer {
    QuadBatchInfo ssbo_quadBatchInfoBuffer[];
};

layout(std430) restrict readonly buffer QuadPosDataBuffer {
    uint ssbo_quadPosDataBuffer[];
};

layout(std430) restrict readonly buffer QuadPosIndexBuffer {
    uint ssbo_quadPosIndexBuffer[];
};


const vec3 coordConvert = vec3(2.51773861295491E-4);

float rand(float v) {
    return fract(sin(v * 91.3458) * 47453.5453);
}

float rand(vec2 v) {
    return fract(sin(dot(v, vec2(12.9898, 78.233))) * 43578.5453);
}

vec2 r2Seq2(uint idx) {
    const float g = 1.32471795724474602596;
    const vec2 a = vec2(1.0 / g, 1.0 / (g * g));
    return fract(0.5 + a * idx);
}

vec4 readPos(uint idx) {
    uint data1 = ssbo_quadPosDataBuffer[idx];
    uint data2 = ssbo_quadPosDataBuffer[idx + 1];
    return vec4(uvec4(data1 & 0xFFFFu, data1 >> 16u, data2 & 0xFFFFu, data2 >> 16u));
}

