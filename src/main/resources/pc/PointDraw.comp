const vec4 BCOORDS[] = {
vec4(0.5, 0.375, 0.0, 0.125),
vec4(0.125, 0.5, 0.375, 0.0),
vec4(0.0, 0.125, 0.5, 0.375),
vec4(0.375, 0.0, 0.125, 0.5)
};

void main() {
    BatchMetadata batchMetadata = ssbo_batchMetadataBuffer[gl_WorkGroupID.x];
    uint negSampleCount = uint(-batchMetadata.pointSampleCount);

    uint wgQuadIndex = batchMetadata.pointSampleCount < 0 ?
    gl_LocalInvocationID.x * negSampleCount + ((ubo_cameraDefault.gFrameIndex + gl_LocalInvocationID.x) & uint(negSampleCount - 1)) :
    gl_LocalInvocationID.x / batchMetadata.pointSampleCount;

    if (wgQuadIndex >= batchMetadata.count) return;
    uint quadIndex = batchMetadata.first + wgQuadIndex;

    vec3 chunkOffset = vec3(uvec3(batchMetadata.encoded_offsets) >> uvec3(0u, 8u, 16u) & uvec3(255u));
    chunkOffset = chunkOffset * 16.0 + uval_originOffset;


    vec4 bCoord = BCOORDS[gl_LocalInvocationID.x & 3u];
//    uint r2idx = uint(rand(float(gl_LocalInvocationID.x)) * 512.0) + (ubo_cameraDefault.gFrameIndex);
//    vec2 r2 = r2Seq2(r2idx);
//    r2.y = sqrt(r2.y);
//    switch ((ubo_cameraDefault.gFrameIndex + gl_LocalInvocationID.x) & 3u) {
//        case 0:
//            bCoord = vec4(
//                r2.x * 1.0,
//                1.0 - r2.y,
//                1.0 - r2.x * 1.0,
//                0.0
//            );
//            bCoord.xz *= r2.y;
//            break;
//        case 1:
//            bCoord = vec4(
//                r2.x * 1.0,
//                0.0,
//                1.0 - r2.x * 1.0,
//                1.0 - r2.y
//            );
//            bCoord.xz *= r2.y;
//            break;
//        case 2:
//            bCoord = vec4(
//                0.0,
//                r2.x * 1.0,
//                1.0 - r2.y,
//                1.0 - r2.x * 1.0
//            );
//            bCoord.yw *= r2.y;
//            break;
//        case 3:
//            bCoord = vec4(
//                1.0 - r2.y,
//                r2.x * 1.0,
//                0.0,
//                1.0 - r2.x * 1.0
//            );
//            bCoord.yw *= r2.y;
//            break;
//    }
//    bCoord /= dot(bCoord, vec4(1.0));

    uint quadPosDataIdx = ssbo_quadPosIndexBuffer[quadIndex] * 6u;

    vec4 posX = readPos(quadPosDataIdx);
    vec4 posY = readPos(quadPosDataIdx + 2u);
    vec4 posZ = readPos(quadPosDataIdx + 4u);

    posX *= bCoord;
    posY *= bCoord;
    posZ *= bCoord;

    vec2 posX2 = posX.xy + posX.zw;
    vec2 posY2 = posY.xy + posY.zw;
    vec2 posZ2 = posZ.xy + posZ.zw;

    vec3 pointPos = vec3(posX2.x + posX2.y, posY2.x + posY2.y, posZ2.x + posZ2.y);
    //    vec3 pointPos = vec3(
    //        mix(posX.xy, posX.zw, r2.x)
    //    );

    vec4 coordCS = ubo_cameraDefault.combined * vec4(pointPos * coordConvert + chunkOffset, 1.0);
    vec3 coordNDC = coordCS.xyz / coordCS.w;

    //    if (coordCS.w <= 0.0 || any(greaterThanEqual(abs(coordNDC), vec3(1.0)))) return;

    vec3 coordTS = coordNDC * 0.5 + 0.5;
    ivec2 outputCoord = ivec2(coordTS.xy * uval_viewportSize);

    uint depth = floatBitsToUint(coordCS.w);

    uint oldValue = imageLoad(uimg_depthRenderTex, outputCoord).x;
    if (depth > oldValue) return;

    uint writeIdx = outputCoord.y * uval_viewportSizeUI.x + outputCoord.x;
    uvec4 pballot = subgroupPartitionNV(writeIdx);

    uint sgMinDepth = subgroupPartitionedMinNV(depth, pballot);

    if (subgroupBallotFindLSB(pballot) == gl_SubgroupInvocationID) {
        uint minDepth = imageAtomicMin(uimg_depthRenderTex, outputCoord, sgMinDepth);
        if (minDepth > sgMinDepth) {
            imageStore(uimg_vbufferRender, outputCoord, uvec4(quadIndex, vbuffer_encodeBCoord(bCoord), 0u, 0u));
        }
    }
}
