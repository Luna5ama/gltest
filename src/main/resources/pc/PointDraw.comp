#version 460 core

#include "GlobalCamera.glsl"

layout(local_size_x = BATCH_SIZE, local_size_y = 1, local_size_z = 1) in;

uniform vec3 uval_originOffset;
uniform vec4 uval_viewportSize;
uniform uvec2 uval_viewportSizeUI;

layout(rg32ui) uniform restrict writeonly uimage2D uimg_vbufferRender;
layout(r32ui) uniform restrict uimage2D uimg_depthRenderTex;
#ifdef OVERDRAW_DEBUG
layout(r32ui) uniform uimage2D uimg_overdrawCounter;
#endif

struct PointBatchInfo {
    uint first;
    uint count;
    uint encoded_offsets;
    int pointSamplePow2;
};

layout(std430) restrict readonly buffer PointBatchInfoBuffer {
    PointBatchInfo ssbo_pointBatchInfoBuffer[];
};

layout(std430) restrict readonly buffer QuadPosDataBuffer {
    uint ssbo_quadPosDataBuffer[];
};

layout(std430) restrict readonly buffer QuadPosIndexBuffer {
    uint ssbo_quadPosIndexBuffer[];
};


const vec3 coordConvert = vec3(2.51773861295491E-4);

float rand(float v) {
    return fract(sin(v * 91.3458) * 47453.5453);
}

float rand(vec2 v) {
    return fract(sin(dot(v, vec2(12.9898, 78.233))) * 43578.5453);
}

vec2 r2Seq2(uint idx) {
    const float g = 1.32471795724474602596;
    const vec2 a = vec2(1.0 / g, 1.0 / (g * g));
    return fract(0.5 + a * idx);
}

vec4 readPos(uint idx) {
    uvec4 data = uvec2(ssbo_quadPosDataBuffer[idx], ssbo_quadPosDataBuffer[idx + 1]).xxyy;
    data = (data >> uvec4(0u, 16u, 0u, 16u)) & uvec4(0xFFFFu);
    return vec4(data);
}


#ifdef OVERDRAW_DEBUG
#define WRITE_POINT(be) imageStore(uimg_vbufferRender, outputCoord, uvec4(quadIndex, be, 0u, 0u));\
imageAtomicAdd(uimg_overdrawCounter, outputCoord, 1u);
#else
#define WRITE_POINT(be) imageStore(uimg_vbufferRender, outputCoord, uvec4(quadIndex, be, 0u, 0u));
#endif

#define DRAW_POINT(bc, be) bCoord = bc;\
coordCS = vec3(dot(posX, bCoord), dot(posY, bCoord), dot(posZ, bCoord));\
outputCoord = ivec2(coordCS.xy * uval_viewportSize.xy);\
depth = floatBitsToUint(coordCS.z);\
if (depth < imageLoad(uimg_depthRenderTex, outputCoord).x) {\
minDepth = imageAtomicMin(uimg_depthRenderTex, outputCoord, depth);\
if (minDepth > depth) {\
WRITE_POINT(be)\
}\
}\

void main() {
    PointBatchInfo batchMetadata = ssbo_pointBatchInfoBuffer[gl_WorkGroupID.x];
    uint metaFirst = batchMetadata.first;
    uint metaCount = batchMetadata.count;
    uint metaEncodedOffsets = batchMetadata.encoded_offsets;
    int metaPointSamplePow2 = batchMetadata.pointSamplePow2;

    vec3 chunkOffset = vec3(uvec3(metaEncodedOffsets) >> uvec3(0u, 8u, 16u) & uvec3(255u));
    chunkOffset = chunkOffset * 16.0 + uval_originOffset;
    uint samplePow2 = max(0, metaPointSamplePow2);
    uint sampleCount = 1u << samplePow2;

    uint wgQuadIndex = metaPointSamplePow2 >= 0 ?
    gl_LocalInvocationID.x :
    gl_LocalInvocationID.x * (1u << -metaPointSamplePow2) + ((ubo_cameraDefault.gFrameIndex + gl_LocalInvocationID.x) & uint((1u << -metaPointSamplePow2) - 1));
    if (wgQuadIndex >= metaCount) return;

    uint quadIndex = metaFirst + wgQuadIndex;

    uint quadPosDataIdx = ssbo_quadPosIndexBuffer[quadIndex] * 6u;

    vec4 posX = readPos(quadPosDataIdx);
    vec4 posY = readPos(quadPosDataIdx + 2u);
    vec4 posZ = readPos(quadPosDataIdx + 4u);

    vec3 pos1 = (ubo_cameraDefault.combined * vec4(vec3(posX.x, posY.x, posZ.x) * coordConvert + chunkOffset, 1.0)).xyw;
    vec3 pos2 = (ubo_cameraDefault.combined * vec4(vec3(posX.y, posY.y, posZ.y) * coordConvert + chunkOffset, 1.0)).xyw;
    vec3 pos3 = (ubo_cameraDefault.combined * vec4(vec3(posX.z, posY.z, posZ.z) * coordConvert + chunkOffset, 1.0)).xyw;
    vec3 pos4 = (ubo_cameraDefault.combined * vec4(vec3(posX.w, posY.w, posZ.w) * coordConvert + chunkOffset, 1.0)).xyw;

    vec4 pos12 = vec4(pos1.xy, pos2.xy);
    vec4 pos34 = vec4(pos3.xy, pos4.xy);

    vec4 posZInv = 1.0 / vec4(pos1.z, pos2.z, pos3.z, pos4.z);

    pos12 = pos12 * posZInv.xxyy;
    pos34 = pos34 * posZInv.zzww;

    if (any(lessThanEqual(vec4(pos1.z, pos2.z, pos3.z, pos4.z), vec4(0.0)))) return;

    if (determinant(mat2(pos34.xy - pos12.xy, pos12.zw - pos12.xy)) >= 0.0) {
        return;
    }

    if (any(bvec2(
        any(greaterThanEqual(abs(pos12), vec4(1.0))),
        any(greaterThanEqual(abs(pos34), vec4(1.0)))
    ))) return;

    pos12 = pos12 * 0.5 + 0.5;
    pos34 = pos34 * 0.5 + 0.5;

    posX = vec4(pos12.xz, pos34.xz);
    posY = vec4(pos12.yw, pos34.yw);
    posZ = vec4(pos1.z, pos2.z, pos3.z, pos4.z);

    vec4 bCoord;
    vec3 coordCS;
    ivec2 outputCoord;
    uint depth;
    uint minDepth;
    switch (samplePow2) {
        UNROLLED_CODE;
    }
}