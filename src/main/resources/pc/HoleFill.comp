#version 460 core
#extension GL_ARB_gpu_shader_int64 : enable

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;


layout(r32ui) uniform readonly uimage2D uimg_vBufferBCoord;
layout(std430) readonly buffer VBufferDepthQuadIndex {
    uint64_t ssbo_vBufferRender[];
};

layout(rg32ui) uniform writeonly uimage2D uimg_vbuffer;
layout(r32ui) uniform writeonly uimage2D uimg_vbufferDepth;

void main() {
    ivec2 outputSize = imageSize(uimg_vbufferDepth);
    ivec2 centerCoord = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(centerCoord, outputSize))) {
        return;
    }

    uint bufferIndex = centerCoord.y * outputSize.x + centerCoord.x;
    uint64_t dataRaw = ssbo_vBufferRender[bufferIndex];
    uint depth = uint(dataRaw >> 32u);
    uint quadIndex = uint(dataRaw);
    uint bCoord = imageLoad(uimg_vBufferBCoord, centerCoord).x;

    imageStore(uimg_vbuffer, centerCoord, uvec4(quadIndex, bCoord, 0u, 0u));
    imageStore(uimg_vbufferDepth, centerCoord, uvec4(depth, 0u, 0u, 0u));
}
