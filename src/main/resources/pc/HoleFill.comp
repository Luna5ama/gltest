#version 460 core
#extension GL_ARB_gpu_shader_int64 : enable

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(r32ui) uniform readonly uimage2D uimg_depthInput;
layout(r32ui) uniform writeonly uimage2D uimg_depthOutput;

layout(r32ui) uniform readonly uimage2D uimg_vbufferRender;
layout(rg32ui) uniform writeonly uimage2D uimg_vbuffer;

layout(std430) readonly buffer VBufferRender {
    uint64_t ssbo_vBufferRender[];
};

ivec2 outputSize = imageSize(uimg_depthOutput);

uint getIndex(ivec2 coord) {
    return coord.y * outputSize.x + coord.x;
}

uint readDepth(ivec2 coord) {
    return imageLoad(uimg_depthInput, coord).x;
}

