layout(rg32ui) uniform restrict writeonly uimage2D uimg_vbufferCombined;

ivec2 outputSize = imageSize(uimg_depthOutput);

uint getIndex(ivec2 coord) {
    return coord.y * outputSize.x + coord.x;
}

uint readDepth(ivec2 coord) {
    return imageLoad(uimg_depthInput, coord).x;
}

