#version 460 core

#include "vbuffer/VBuffers.glsl"
#include "GlobalCamera.glsl"
#include "utils/SWRUtils.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

uniform vec4 uval_viewportSize;
uniform vec3 uval_originOffset;

layout(rg32ui) uniform readonly uimage2D uimg_vBufferTex2;
layout(rgba16f) uniform writeonly image2D uimg_output;

uniform sampler2D usam_blockAlbedoAtlas;
uniform sampler2D usam_lightMap;

uniform sampler2D usam_vBufferDepth;

layout(std430) restrict readonly buffer QuadPosDataBuffer {
    uint ssbo_quadPosDataBuffer[];
};

layout(std430) restrict readonly buffer QuadPosIndexBuffer {
    uint ssbo_quadPosIndexBuffer[];
};

layout(std430) readonly buffer QuadTexCoordDataBuffer {
    uint ssbo_quadTexCoordDataBuffer[];
};

layout(std430) readonly buffer QuadExtraAttribDataBuffer {
    uint ssbo_quadExtraAttribDataBuffer[];
};

layout(std430) readonly buffer QuadAttribIndexBuffer {
    uint ssbo_quadAttribIndexBuffer[];
};

ivec2 outputSize = imageSize(uimg_output);

const float coordConvert = 2.51773861295491E-4;

vec4 readPos(uint idx) {
    uvec4 data = uvec2(ssbo_quadPosDataBuffer[idx], ssbo_quadPosDataBuffer[idx + 1]).xxyy;
    data = (data >> uvec4(0u, 16u, 0u, 16u)) & uvec4(0xFFFFu);
    return vec4(data);
}

void main() {
    ivec2 centerCoord = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(centerCoord, outputSize))) {
        return;
    }
    float linearDepth = texelFetch(usam_vBufferDepth, centerCoord, 0).r;
    if (linearDepth == ubo_cameraDefault.planeZ.y) {
        return;
    }

    uvec2 vbufferData = imageLoad(uimg_vBufferTex2, centerCoord).xy;
    uint quadIndex = vbufferData.x;
    vec4 bCoord = vbuffer_decodeBCoord(vbufferData.y);

    uint attribIdx = ssbo_quadAttribIndexBuffer[quadIndex];
    uint texCoordIdx = attribIdx * 4u;
    vec4 texCoordX = vec4(
        unpackUnorm2x16(ssbo_quadTexCoordDataBuffer[texCoordIdx]),
        unpackUnorm2x16(ssbo_quadTexCoordDataBuffer[texCoordIdx + 1u])
    );
    vec4 texCoordY = vec4(
        unpackUnorm2x16(ssbo_quadTexCoordDataBuffer[texCoordIdx + 2u]),
        unpackUnorm2x16(ssbo_quadTexCoordDataBuffer[texCoordIdx + 3u])
    );
    vec2 texCoord = vec2(dot(texCoordX, bCoord), dot(texCoordY, bCoord));

    uint quadPosDataIdx = ssbo_quadPosIndexBuffer[quadIndex] * 6u;

    vec3 viewCoord = vec3(vec2(centerCoord) + 0.5, -linearDepth);
    viewCoord.xy = viewCoord.xy * uval_viewportSize.zw * 2.0 - 1.0;
    viewCoord.xy *= linearDepth;
    viewCoord.xy /= vec2(ubo_cameraDefault.projection[0][0], ubo_cameraDefault.projection[1][1]);
    vec3 worldCoord = (ubo_cameraDefault.invModelView * vec4(viewCoord, 1.0)).xyz;

    vec4 posX = readPos(quadPosDataIdx) * coordConvert;
    vec4 posY = readPos(quadPosDataIdx + 2u) * coordConvert;
    vec4 posZ = readPos(quadPosDataIdx + 4u) * coordConvert;

    vec3 interpolatedPos = vec3(
        dot(posX, bCoord),
        dot(posY, bCoord),
        dot(posZ, bCoord)
    );

    vec3 offset = worldCoord.xyz - interpolatedPos;

    vec3 pos1 = (ubo_cameraDefault.combined * vec4(vec3(posX.x, posY.x, posZ.x) + offset, 1.0)).xyw;
    vec3 pos2 = (ubo_cameraDefault.combined * vec4(vec3(posX.y, posY.y, posZ.y) + offset, 1.0)).xyw;
    vec3 pos3 = (ubo_cameraDefault.combined * vec4(vec3(posX.z, posY.z, posZ.z) + offset, 1.0)).xyw;
    vec3 pos4 = (ubo_cameraDefault.combined * vec4(vec3(posX.w, posY.w, posZ.w) + offset, 1.0)).xyw;

    vec4 pos12 = vec4(pos1.xy, pos2.xy);
    vec4 pos34 = vec4(pos3.xy, pos4.xy);

    vec4 posZInv = 1.0 / vec4(pos1.z, pos2.z, pos3.z, pos4.z);

    pos12 = pos12 * posZInv.xxyy;
    pos34 = pos34 * posZInv.zzww;

    pos12 = pos12 * 0.5 + 0.5;
    pos34 = pos34 * 0.5 + 0.5;

    pos1 = vec3(pos12.xy, pos1.z);
    pos2 = vec3(pos12.zw, pos2.z);
    pos3 = vec3(pos34.xy, pos3.z);
    pos4 = vec3(pos34.zw, pos4.z);

    vec4 screenBound = clamp(vec4(min(min(pos1.xy, pos2.xy), min(pos3.xy, pos4.xy)), max(max(pos1.xy, pos2.xy), max(pos3.xy, pos4.xy))), 0.0, 1.0);
    screenBound *= uval_viewportSize.xyxy;
    vec4 boundRounded = vec4(floor(screenBound.xy), ceil(screenBound.zw));
    screenBound = boundRounded * uval_viewportSize.zwzw;

    vec2 texelNF = boundRounded.zw - boundRounded.xy;
    vec2 invTexelN = 1.0 / texelNF;
    ivec2 texelNI = ivec2(texelNF);

    vec3 t1bBase, t1bMx, t1bMy, t1bDx, t1bDy;
    swr_calcBarycentricGrad(screenBound, invTexelN, pos1.xy, pos2.xy, pos3.xy, t1bBase, t1bMx, t1bMy, t1bDx, t1bDy);

    vec2 tTexCoordBase, tTexCoordDx, tTexCoordDy;
    swr_calcAttribGrad(invTexelN, t1bBase, t1bMx, t1bMy, texCoordX.xyz, texCoordY.xyz, tTexCoordBase, tTexCoordDx, tTexCoordDy);

    {
        uint extraAttribIdx = attribIdx * 6u;
        vec4 lightCoordX = unpackUnorm4x8(ssbo_quadExtraAttribDataBuffer[extraAttribIdx]);
        vec4 lightCoordY = unpackUnorm4x8(ssbo_quadExtraAttribDataBuffer[extraAttribIdx + 1u]);
        vec2 lightCoord = vec2(dot(lightCoordX, bCoord), dot(lightCoordY, bCoord));

        vec4 colorMulR = unpackUnorm4x8(ssbo_quadExtraAttribDataBuffer[extraAttribIdx + 2u]);
        vec4 colorMulG = unpackUnorm4x8(ssbo_quadExtraAttribDataBuffer[extraAttribIdx + 3u]);
        vec4 colorMulB = unpackUnorm4x8(ssbo_quadExtraAttribDataBuffer[extraAttribIdx + 4u]);
        vec3 colorMul = vec3(
            dot(colorMulR, bCoord),
            dot(colorMulG, bCoord),
            dot(colorMulB, bCoord)
        );
        uint materialID = ssbo_quadExtraAttribDataBuffer[extraAttribIdx + 5u];

//        vec4 colorMaxLod = textureLod(usam_blockAlbedoAtlas, texCoord, 114.514);
        vec4 colorMinLod = textureLod(usam_blockAlbedoAtlas, texCoord, 0.0);
//        vec4 colorNormal = textureGrad(usam_blockAlbedoAtlas, texCoord, tTexCoordDx, tTexCoordDy);
        vec4 colorNormal = colorMinLod;

        vec4 colorFinal = colorMinLod;
//        vec4 colorFinal = mix(colorMaxLod, colorNormal, colorMinLod.a);
        colorFinal.rgb *= colorMul;
        colorFinal.rgb *= textureLod(usam_lightMap, lightCoord, 0.0).rgb;
        colorFinal.a = 1.0;
//        colorFinal.rgb = vec3(float((materialID >> 1u) & 1u));

//        colorFinal.r = tTexCoordDx.x;
//        colorFinal.g = tTexCoordDy.y;
//        colorFinal.rgb = offset;

        imageStore(uimg_output, centerCoord, colorFinal);
    }
}
