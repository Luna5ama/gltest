#version 460 core

#include "vbuffer/VBuffers.glsl"
#include "GlobalCamera.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(rg32ui) uniform readonly uimage2D uimg_vbuffer;
layout(rgba16f) uniform writeonly image2D uimg_output;

uniform sampler2D usam_blockAlbedoAtlas;
uniform sampler2D usam_lightMap;

uniform sampler2D usam_mainFbo_inputDepth;

layout(std430) readonly buffer QuadAttribDataBuffer {
    uint ssbo_quadAttribDataBuffer[];
};

layout(std430) readonly buffer QuadAttribIndexBuffer {
    uint ssbo_quadAttribIndexBuffer[];
};

ivec2 outputSize = imageSize(uimg_output);

void main() {
    ivec2 centerCoord = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(centerCoord, outputSize))) {
        return;
    }
    if (texelFetch(usam_mainFbo_inputDepth, centerCoord, 0).r == 1.0) {
        return;
    }

    uvec2 vbufferData = imageLoad(uimg_vbuffer, centerCoord).xy;
    uint quadIndex = vbufferData.x;
    vec4 bCoord = vbuffer_decodeBCoord(vbufferData.y);

    uint pointAttriIdx = ssbo_quadAttribIndexBuffer[quadIndex] * 12u;

    vec2 texCoord = vec2(0.0);
    texCoord += unpackUnorm2x16(ssbo_quadAttribDataBuffer[pointAttriIdx]) * bCoord.x;
    texCoord += unpackUnorm2x16(ssbo_quadAttribDataBuffer[pointAttriIdx + 3u]) * bCoord.y;
    texCoord += unpackUnorm2x16(ssbo_quadAttribDataBuffer[pointAttriIdx + 6u]) * bCoord.z;
    texCoord += unpackUnorm2x16(ssbo_quadAttribDataBuffer[pointAttriIdx + 9u]) * bCoord.w;

    vec4 colorFinal = textureLod(usam_blockAlbedoAtlas, texCoord, 5.0);

    vec3 color = vec3(0.0);
    color += unpackUnorm4x8(ssbo_quadAttribDataBuffer[pointAttriIdx + 2u]).rgb * bCoord.x;
    color += unpackUnorm4x8(ssbo_quadAttribDataBuffer[pointAttriIdx + 5u]).rgb * bCoord.y;
    color += unpackUnorm4x8(ssbo_quadAttribDataBuffer[pointAttriIdx + 8u]).rgb * bCoord.z;
    color += unpackUnorm4x8(ssbo_quadAttribDataBuffer[pointAttriIdx + 11u]).rgb * bCoord.w;
    colorFinal.rgb *= color;

    vec2 lightMapCoord = vec2(0.0);
    lightMapCoord += unpackUnorm4x8(ssbo_quadAttribDataBuffer[pointAttriIdx + 1u]).xy * bCoord.x;
    lightMapCoord += unpackUnorm4x8(ssbo_quadAttribDataBuffer[pointAttriIdx + 4u]).xy * bCoord.y;
    lightMapCoord += unpackUnorm4x8(ssbo_quadAttribDataBuffer[pointAttriIdx + 7u]).xy * bCoord.z;
    lightMapCoord += unpackUnorm4x8(ssbo_quadAttribDataBuffer[pointAttriIdx + 10u]).xy * bCoord.w;

    vec4 lightMap = textureLod(usam_lightMap, lightMapCoord, 0.0);
    colorFinal.rgb *= lightMap.rgb;
    colorFinal.a = 1.0;

    imageStore(uimg_output, centerCoord, colorFinal);
}
